#!/usr/bin/env bash
# Fake zccache for the P13 tests; the same model as fake-zccache.ps1 (the key leaves out the -o name). Like zccache
# 1.15.6 it runs its daemon from a copy it deploys into the root, ROOT/v1.15.6/zccache-daemon, made from the
# zccache-daemon beside this file (the tests copy `sleep` there); a file named daemon-in-bin beside this file makes it
# run that one in place, as zccache does when the copy fails (a file, because init starts daemons under env -i). A hit
# delivers the object and, with -MD/-MMD, the depfile.
# FAKE_ZC_HANG=SECONDS turns a compile call into a hung client: it records its pid in fake-client.pid and becomes
# zccache-daemon (a process from the bin folder, like a real client) for that long. With FAKE_ZC_LATE=SECONDS it first
# leaves a child behind that writes LATE to the -o file after that long (a straggler).
# Delivery faults on a hit, all exiting 0: FAKE_ZC_NODELIVER=1 writes nothing, FAKE_ZC_EMPTY=1 an empty object,
# FAKE_ZC_LINK=1 a symbolic link to the entry, FAKE_ZC_HARDLINK=1 a hard link to it. FAKE_ZC_PROGRESS=N first prints N
# of zccache's progress lines to stderr.
# FAKE_ZC_STDIN=1, or a file named stdin-probe beside this file (init starts the daemon under env -i, which drops the
# variable), (P04.1) records eof in fake-stdin.log and carries on when this call's stdin is at EOF; any open or
# feeding stdin is recorded as open and fails the call with exit 7, as a client handed the caller's stdin would hang.
root=${ZCCACHE_CACHE_DIR:?}
mkdir -p "${root}/artifacts"
names=$(env -0 | while IFS= read -r -d '' kv; do printf '%s\n' "${kv%%=*}"; done | sort | tr '\n' ' ')
printf '%s MODE=%s SIZE=%s\n' "${names}" "${ZCCACHE_MODE:-}" "${ZCCACHE_CACHE_SIZE_BYTES:-}" >> "${root}/fake-env.log"
if [[ -n "${FAKE_ZC_STDIN:-}" || -e "$(dirname "$0")/stdin-probe" ]]; then
  read -t 2 -r _; rc=$?  # 0 data, 1 EOF, >128 still open after 2 s
  if [[ ${rc} -ne 1 ]]; then printf 'open\n' > "${root}/fake-stdin.log"; exit 7; fi
  printf 'eof\n' > "${root}/fake-stdin.log"
fi
[[ "${FAKE_ZC_CRASH:-}" == 1 ]] && exit 139
case "$1" in
  session-start)
    pidf="${root}/fake-daemon.pid"
    if ! { [[ -f "${pidf}" ]] && kill -0 "$(cat "${pidf}")" 2> /dev/null; }; then
      daemon="$(dirname "$0")/zccache-daemon"
      if [[ ! -e "$(dirname "$0")/daemon-in-bin" ]]; then
        mkdir -p "${root}/v1.15.6" && cp -- "${daemon}" "${root}/v1.15.6/zccache-daemon" && daemon="${root}/v1.15.6/zccache-daemon"
      fi
      "${daemon}" 600 < /dev/null > /dev/null 2>&1 &
      echo $! > "${pidf}"
    fi
    echo '{"session_id":"fake-session"}'
    exit 0 ;;
  session-end) exit 0 ;;
esac
for ((i = 0; i < ${FAKE_ZC_PROGRESS:-0}; i++)); do
  echo "zccache[info][Q]: daemon under load: compiling, $((i + 2)) compiles in flight" >&2
done
cc=$1; shift
out="" in="" mf="" md=0 args=("$@") keyargs=()
for ((i = 0; i < ${#args[@]}; i++)); do
  if [[ "${args[i]}" == -o ]]; then out=${args[i + 1]}; i=$((i + 1)); continue; fi
  [[ "${args[i]}" == -MF ]] && mf=${args[i + 1]}
  [[ "${args[i]}" == -MD || "${args[i]}" == -MMD ]] && md=1
  [[ -f "${args[i]}" ]] && in=${args[i]}
  keyargs+=("${args[i]}")
done
dep=""; [[ ${md} == 1 && -n "${out}" ]] && dep=${mf:-${out%.*}.d}
if [[ -n "${FAKE_ZC_HANG:-}" ]]; then
  echo $$ > "${root}/fake-client.pid"
  [[ -n "${FAKE_ZC_LATE:-}" && -n "${out}" ]] && { sleep "${FAKE_ZC_LATE}"; echo LATE > "${out}"; } < /dev/null > /dev/null 2>&1 &
  exec "$(dirname "$0")/zccache-daemon" "${FAKE_ZC_HANG}"
fi
key=$({ printf '%s\n' "${cc}" "${keyargs[@]}"; [[ -n "${in}" ]] && cat -- "${in}"; } | sha256sum | cut -d' ' -f1)
store="${root}/artifacts/${key}"
deliver() { # ENTRY TARGET: whole or not at all, read with one open (cat): concurrent misses rename new entries over the
  # entry, and GNU cp refuses a source renamed between its stat and its open, exiting 1 with no output.
  local tmp="$2.zc$$"
  if [[ "${ZCCACHE_MODE:-}" == COPY ]]; then cat -- "$1" > "${tmp}"; else ln -f -- "$1" "${tmp}"; fi &&
    mv -f -- "${tmp}" "$2" || { rm -f -- "${tmp}"; return 1; }
}
if [[ -n "${out}" && -f "${store}" && ( -z "${dep}" || -f "${store}.dep" ) ]]; then
  if [[ "${FAKE_ZC_VERIFY:-}" == 1 && "$(sha256sum < "${store}" | cut -d' ' -f1)" != "$(cat "${store}.sha")" ]]; then
    echo "fake-zccache: corrupt entry" >&2
    exit 5
  fi
  echo hit >> "${root}/fake-journal.log"
  [[ "${FAKE_ZC_NODELIVER:-}" == 1 ]] && exit 0
  [[ "${FAKE_ZC_EMPTY:-}" == 1 ]] && { : > "${out}"; exit 0; }
  [[ "${FAKE_ZC_LINK:-}" == 1 ]] && { ln -sf -- "${store}" "${out}"; exit 0; }
  [[ "${FAKE_ZC_HARDLINK:-}" == 1 ]] && { ln -f -- "${store}" "${out}"; exit 0; }
  # Like a real cache: a delivery that fails is a failed call, and an output appears whole or not at all.
  deliver "${store}" "${out}" && { [[ -z "${dep}" ]] || deliver "${store}.dep" "${dep}"; } ||
    { echo "fake-zccache: cannot deliver ${out}" >&2; exit 6; }
  exit 0
fi
echo miss >> "${root}/fake-journal.log"
"${cc}" "$@" || exit $?
if [[ -n "${out}" && -f "${out}" ]]; then
  [[ -n "${dep}" && -f "${dep}" ]] && cp -- "${dep}" "${store}.dep.$$.tmp" && mv -f -- "${store}.dep.$$.tmp" "${store}.dep"
  cp -- "${out}" "${store}.$$.tmp" && mv -f -- "${store}.$$.tmp" "${store}"
  sha256sum < "${store}" | cut -d' ' -f1 > "${store}.sha"
fi
exit 0
