#!/usr/bin/env bash
# Fake compiler for the P13 tests (no real toolchain): -o OUT gets "OBJ" plus the input file; "#error" in the input
# fails with exit 1 and no output; --version prints a banner; @FILE names the input inside a response file.
out="" in=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --version) echo "fake-cc version 18.1.3"; exit 0 ;;
    -o) out=$2; shift 2; continue ;;
    @*) while IFS= read -r t; do [[ -f "${t}" ]] && in=${t}; done < <(grep -oE '[^[:space:]]+' -- "${1:1}") ;;
    *) [[ -f "$1" ]] && in=$1 ;;
  esac
  shift
done
[[ -n "${in}" ]] || { echo "fake-cc: no input" >&2; exit 2; }
grep -q '#error' -- "${in}" && { echo "fake-cc: error: deliberate" >&2; exit 1; }
[[ -z "${out}" ]] && exit 0
{ echo OBJ; cat -- "${in}"; } > "${out}"
