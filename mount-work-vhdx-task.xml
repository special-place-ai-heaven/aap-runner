<?xml version="1.0" encoding="UTF-16"?>
<!-- Source file is UTF-8 so it can be reviewed. Bootstrap rewrites the
     installed copy as UTF-16 LE with a BOM. schtasks /XML rejects UTF-8. -->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Attach the fixed AAP work VHDX to the installing operator's WSL at logon. WSL mounts are per Windows user, so this task runs as that operator, not as SYSTEM. Touches only that VHDX path.</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>__AAP_USER_SID__</UserId>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>__AAP_USER_SID__</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <ExecutionTimeLimit>PT2M</ExecutionTimeLimit>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$env:PSModulePath=[Environment]::GetEnvironmentVariable('PSModulePath','Machine'); if ([string]::IsNullOrEmpty($env:PSModulePath)) { Write-Error 'refusing: machine PSModulePath is empty'; exit 1 }; &amp; '__AAP_PS1__'"</Arguments>
    </Exec>
  </Actions>
</Task>
