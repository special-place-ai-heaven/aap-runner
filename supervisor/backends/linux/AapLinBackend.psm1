# Linux VM backend (ledger item P11): the supervisor-side provider for `hyperv-vm` Linux (Ubuntu 24.04) reservations.
# Windows PowerShell 5.1 and PowerShell 7.5 or later (the allocator module refuses 6.0 to 7.4). The Windows twin is
# supervisor/backends/windows (P10); this module follows its rules and its review lessons, and differs where a Linux guest
# differs: the host never mounts a guest disk (Windows cannot read ext4), files go in on a host-built NoCloud seed ISO that
# holds only public material, and the management channel is OpenSSH over a Hyper-V socket with a pinned host key.
#
# Contracts: parity/contracts/backend-lifecycle.md (version 3), guest-transport.md (version 2), allocator.md ("Provider
# rules for P10 and P11", "Hard VM lifetime cap" L1 to L10 and B1 to B9), vm-cap-notes.schema.json and broker.md (version 1).
#
# Invoke-AapLinStep moves one reservation one step, by its allocator state:
#   creating   create (base re-hash, differencing disk, per-clone key pair and seed ISO, VM, network), boot, ready (host key
#              pinned from the guest's first boot, probe, seed ejected)
#   ready      run_one: broker lease, deliver_registration (JIT on the ssh call child's stdin), start_runner
#   ready, busy, draining   heartbeat: guest status over the host-side channel, JobRunning from the broker
#   every step of a reservation with a VM: the clone cap and a paused VM, host-side, with or without a guest channel
#   collecting collect (the bounded job summary)        deleting   destroy (release, VM, folders, observed absence)
# The journal, <JournalRoot>\<reservation_id>.jsonl (one backend-lifecycle `op` record per line, admin-only), is the
# state: every op appends `intent` before it acts and `done` or `failed` after, so a supervisor killed anywhere resumes
# from it. The per-clone SSH private key is generated by ssh-keygen straight into an admin-only folder inside the
# reservation's clone folder (guest-transport.md, Linux candidate) and never enters this process; the channel's `seq`
# high-water mark is kept beside it, so a restarted supervisor keeps the guest channel. A job is never cancelled here:
# only a hostile guest, the clone cap, a paused VM (backend-lifecycle.md) or the hard lifetime cap (6 h at most from the
# reservation's start, evaluated first on every step, owner decision Q4) end a running VM.
#
# Hyper-V, disk, seed, key, volume and hash calls go through $Backend.Provider (AapLinBackend.HyperV.psm1 in production,
# fakes in tests), the guest network through $Backend.Network (the P10.0 module, host-network-module.md: Attach, Detach,
# Verify; its consumer obligations are met in create, boot, the limits and destroy), the guest
# channel through $Backend.Transport (one capped ssh.exe child by default) and the clock through $Backend.Now. Allocator
# and broker calls go to AapCapacity.psm1 and aap-broker.psm1 beside this folder.
# Lines tagged '# check:<name>' are the safety checks tests/backends/linux/Invoke-AapLinMutations.ps1 disables one at a
# time; each must make at least one test fail.
# One backend context ($B) belongs to one runspace: its hashtables, its scriptblocks and the process-wide console input
# encoding swap around each child start are not thread-safe. Steps of one reservation never overlap: Invoke-AapLinStep
# holds <JournalRoot>\<reservation_id>.lock (FileShare.None, deleted on close) for the whole step.

Set-StrictMode -Version 2
$ErrorActionPreference = 'Stop'

Import-Module (Join-Path $PSScriptRoot '..\..\capacity\AapCapacity.psm1')
Import-Module (Join-Path $PSScriptRoot '..\..\broker\aap-broker.psm1')
# The shared check of the P10.0 module's work (host-network-module.md, Shared check): the declaration Attach returns and
# Hyper-V's read-back of the VM's adapter. The switch, the guards and the port ACLs are judged there, nowhere else here.
Import-Module (Join-Path $PSScriptRoot '..\..\network\AapHostNetworkCheck.psm1')

$script:ImageProfile = 'ubuntu-24.04-x64'
$script:SshExe = 'C:\Windows\System32\OpenSSH\ssh.exe'
$script:ChildExe = $script:SshExe       # tests point these two at a stand-in; the command line holds the config path only
$script:ChildArgs = '-F "{0}" -T aap-guest'
$script:RelayExe = 'C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe'
$script:RelayScript = Join-Path $PSScriptRoot 'hvsock-relay.ps1'
$script:RelayJobVar = 'AAP_RELAY_JOB'   # names the call child's job object; the relay refuses to run outside it
$script:Agent = '/usr/local/libexec/aap-guest/agent'
$script:SecureBootTemplate = 'MicrosoftUEFICertificateAuthority'
$script:ChildMemoryBytes = 536870912    # job object cap on ssh.exe and its relay, all their processes together
$script:ReplyMax = 8192
$script:ReadMax = 8193                  # one byte past the reply bound: more is a hostile guest
$script:ErrMax = 4096                   # stderr is drained in this buffer and dropped, never parsed
$script:EnvelopeMax = 1024
$script:PayloadMax = 16384
$script:SshFailure = 255                # ssh.exe's own failure (unreachable, auth or host key refused, dropped): a failed guest
$script:SeqBlock = 1000                 # seq values reserved on disk per write (guest-transport.md, Sequence rule)
$script:SeqMax = 2147483647
$script:Timeouts = @{ probe = 30; deliver_registration = 30; start_runner = 60; status = 15; collect = 60 }
# guest_state values a well-behaved agent can answer to each command (anything else is hostile, code bad_state).
$script:Answers = @{ probe = @('booting', 'ready'); deliver_registration = @('registered', 'listening'); start_runner = @('listening', 'busy')
    status = @('listening', 'busy', 'job_done', 'failed'); collect = @('listening', 'busy', 'job_done', 'failed', 'shutting_down')
}
$script:GuestStates = @('booting', 'ready', 'registered', 'listening', 'busy', 'job_done', 'failed', 'shutting_down')
$script:ReplyKeys = @('schema', 'kind', 'vm_id', 'reservation_id', 'lease_generation', 'seq', 'nonce', 'status', 'guest_state', 'runner_exit_code', 'diag')
$script:BootMinutes = 15                # guest-transport.md: probe until 15 min after Start-VM
$script:LeaseWindowMinutes = 15         # a lease call the broker never recorded cannot be recorded after this (55 s run cap)
$script:RetrySeconds = 60               # a pending release is asked again at most this often
$script:TeardownTries = 3               # ARCHITECTURE.md section 10: three retries over 15 s, then quarantined
$script:TeardownPauseSeconds = 5
$script:GiB = 1073741824
$script:JournalMax = 4194304
$script:AdminSids = @('S-1-5-18', 'S-1-5-32-544', 'S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464')
# WriteData, AppendData, WriteEA, DeleteChild, WriteAttributes, Delete, WriteDAC, WriteOwner, GenericAll, GenericWrite.
$script:WriteMask = 0x500D0156
$script:SecretValue = 'gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|SYNTHETIC-JIT-MARKER'
$script:GuidRe = '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z'
$script:RidRe = '^r-[0-9a-f]{16}\z'
$script:GenerationRe = '^ubuntu-24\.04-x64/[0-9]{8}\.[0-9]+\.[0-9]+-aap\.[0-9]+\z'
$script:VmNameRe = '^aap-l-[1-5]-[0-9]{1,9}-[0-9a-f]{8}\z'
# An OpenSSH ed25519 public key: "ssh-ed25519" and the base64 of its 51-byte wire form (68 characters, no padding).
$script:Ed25519Re = '^ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI[A-Za-z0-9+/]{43}\z'
$script:Reserved = '^(CON|PRN|AUX|NUL|COM[0-9]|LPT[0-9]) *(\..*)?$'
$script:ProviderOps = @('GetVolumeGuid', 'GetHostSecurity', 'HashFile', 'NewDiffDisk', 'GetVhdParent', 'NewKeyPair', 'NewSeedImage', 'NewVm',
    'SetSeed', 'GetVmConfig', 'GetHostKey', 'EjectSeed', 'StartVm', 'StopVm', 'RemoveVm', 'ListVms', 'MeasureBytes', 'SetVmNotes', 'GetVmNotes', 'GetBootId')
$script:VmGroupSid = 'S-1-5-83-0'      # NT VIRTUAL MACHINE\Virtual Machines: may read a sealed base (P07), nothing more
# Facts journaled as repeated `ready` `done` records (`op` has no lease field and no field for these): the broker's answer
# right after the lease call, so a restarted supervisor never takes a broker that lost an issued lease for one that never
# recorded it, and the runner start, so a restarted supervisor knows the guest runs a runner it may ask for status.
$script:LeaseAnswers = @('lease issued by the broker', 'lease answer unreadable')
$script:StartedDetail = 'runner started on the guest'
$script:DrainOnline = 'runner online and idle; released at destroy'
$script:StatusSeconds = 30             # guest and broker status at most this often per reservation (allocator: 30 s heartbeat)
$script:Utf8 = New-Object Text.UTF8Encoding($false)
# The hard VM lifetime cap (owner decision Q4; allocator.md L1 to L10, backend-lifecycle.md revision 3). The ceiling is the
# deadline the VM's own Notes carry (B1); the cap in force is $Backend.CapHours, 1..6.
$script:CeilingHours = 6
$script:CapDetail = 'vm lifetime cap reached; the VM was powered off'   # the fixed detail of every op the cap closes
$script:CapBreach = 'cap_breach'        # the VM is not observed Off after the power-off: unresolved, the slot held
$script:WatchdogMax = 65536             # the host watchdog's clock record (B7) is read up to this size
$script:WatchdogFreshSeconds = 180      # B7: no older than this,
$script:WatchdogAheadSeconds = 60       # and no more than this in the future
$script:NetworkOps = @('Attach', 'Detach', 'Verify')
$script:Ops = @('create', 'boot', 'ready', 'run_one', 'drain', 'collect', 'destroy')
# Legal allocator edges down to deleting (draining always passes through collecting).
$script:Down = @{ creating = @('deleting'); ready = @('draining', 'collecting', 'deleting'); busy = @('collecting', 'deleting')
    draining = @('collecting', 'deleting'); collecting = @('deleting')
}
$script:Inv = [Globalization.CultureInfo]::InvariantCulture
$script:DateKind = (Get-Command ConvertFrom-Json).Parameters.ContainsKey('DateKind')
$script:Fault = $null                   # test hook: a fault point name; the process kills itself there

# ---- small helpers ----------------------------------------------------------------------------------------------------

function Invoke-AapLinFault([string]$Point) {
    if ($script:Fault -ceq $Point) {
        [Diagnostics.Process]::GetCurrentProcess().Kill()
        Start-Sleep -Seconds 30
    }
}

function Get-AapLinNow($B) { ([datetime](& $B.Now)).ToUniversalTime() }
function Format-AapLinTime([datetime]$Time) { $Time.ToUniversalTime().ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", $script:Inv) }
function ConvertTo-AapLinUtc($Value) {
    if ($Value -is [datetime]) { return $Value.ToUniversalTime() }
    [DateTime]::ParseExact([string]$Value, "yyyy-MM-dd'T'HH:mm:ss'Z'", $script:Inv, [Globalization.DateTimeStyles]'AssumeUniversal, AdjustToUniversal')
}
function ConvertFrom-AapLinJson([string]$Text) {
    if ($script:DateKind) { return , (ConvertFrom-Json -InputObject $Text -DateKind String) }
    , (ConvertFrom-Json -InputObject $Text)
}
function New-AapLinHex([int]$Bytes) {
    $b = New-Object byte[] $Bytes
    $rng = [Security.Cryptography.RandomNumberGenerator]::Create()
    try { $rng.GetBytes($b) } finally { $rng.Dispose() }
    (($b | ForEach-Object { $_.ToString('x2') }) -join '')
}
# A field of a hashtable or object by exact name, $null when absent.
function Get-AapLinField($Object, [string]$Name) {
    if ($null -eq $Object) { return $null }
    # The comma keeps an array (a byte[] above all) in one piece through the function's output.
    if ($Object -is [Collections.IDictionary]) { if ($Object.Contains($Name)) { return , $Object[$Name] } else { return $null } }
    foreach ($p in $Object.PSObject.Properties) { if ([string]::Equals($p.Name, $Name, [StringComparison]::Ordinal)) { return , $p.Value } }
    $null
}
# One printable-ASCII line of at most Max characters (journal details, quarantine reasons, results). Error texts put the
# reason before any path, so the cut never takes the reason.
function Get-AapLinLine([string]$Text, [int]$Max = 200) {
    if ($null -eq $Text) { return '' }
    $t = [regex]::Replace($Text, '[^\x20-\x7e]', ' ')
    if ($t.Length -gt $Max) { $t = $t.Substring(0, $Max) }
    $t
}
# 'AAP_<Reason>: detail' of an error record, one bounded line.
function Get-AapLinError($ErrorRecord) { Get-AapLinLine ([string]$ErrorRecord.Exception.Message) 200 }

# ---- paths (the patterns of supervisor/backends/windows, P10) ----------------------------------------------------------

# What one path is, without following it: 'absent', 'link' (any reparse point), 'dir' or 'file'. Access denied and every
# other error propagate, so an unreadable entry is never taken for an absent one.
function Get-AapLinPathKind([string]$Path) {
    try { $attr = [int][IO.File]::GetAttributes($Path) } catch [IO.FileNotFoundException], [IO.DirectoryNotFoundException] { return 'absent' }
    if (($attr -band [int][IO.FileAttributes]::ReparsePoint) -ne 0) { return 'link' }
    if (($attr -band [int][IO.FileAttributes]::Directory) -ne 0) { return 'dir' }
    'file'
}

# Walks $Path down from $Root one component at a time and refuses a reparse point anywhere on the way, $Root included.
# With -Create, missing folders are created on the way.
function Assert-AapLinPlainPath {
    param([Parameter(Mandatory)][string]$Root, [Parameter(Mandatory)][string]$Path, [Parameter(Mandatory)][string]$Reason, [switch]$Create)
    $r = [IO.Path]::GetFullPath($Root); $full = [IO.Path]::GetFullPath($Path)
    if ($r.Length -gt 3) { $r = $r.TrimEnd('\') }
    if ($full.Length -gt 3) { $full = $full.TrimEnd('\') }
    $prefix = $(if ($r.EndsWith('\')) { $r } else { $r + '\' })
    if ($full -ne $r -and -not $full.StartsWith($prefix, [StringComparison]::OrdinalIgnoreCase)) { throw "${Reason}: not below its root: $full" }
    $segs = @($(if ($full.Length -gt $r.Length) { $full.Substring($prefix.Length).Split('\') }))
    $walk = $r
    $kind = Get-AapLinPathKind $walk
    foreach ($seg in @('') + $segs) {
        if ($seg) {
            $walk = Join-Path $walk $seg
            $kind = Get-AapLinPathKind $walk
            if ($kind -eq 'absent' -and $Create) { [void][IO.Directory]::CreateDirectory($walk); $kind = Get-AapLinPathKind $walk }
            if ($kind -eq 'absent') { return }
        }
        if ($kind -ne 'dir') { throw "${Reason}: $(@{ link = 'a link'; file = 'a file'; absent = 'missing' }[$kind]), not a plain folder: $walk" }   # check:plain-path
    }
}

# Gives this process's user full control of one entry, replacing its DACL, so an entry whose ACL forbids the delete can
# be deleted right after (an administrator owns every file the supervisor created).
function Grant-AapLinOwnerAccess([string]$Path, [bool]$IsDir) {
    # Setting an ACL follows a link to its target: a link is never re-permissioned, only removed as an entry.
    if ((Get-AapLinPathKind $Path) -ceq 'link') { throw "AAP_UnsafeDelete: a link: $Path" }   # check:grant-link
    $sec = $(if ($IsDir) { New-Object Security.AccessControl.DirectorySecurity } else { New-Object Security.AccessControl.FileSecurity })
    $sec.SetAccessRuleProtection($true, $false)
    $sec.AddAccessRule((New-Object Security.AccessControl.FileSystemAccessRule ([Security.Principal.WindowsIdentity]::GetCurrent().User), 'FullControl', 'Allow'))
    $info = $(if ($IsDir) { New-Object IO.DirectoryInfo $Path } else { New-Object IO.FileInfo $Path })
    if ($PSVersionTable.PSVersion.Major -ge 6) { [IO.FileSystemAclExtensions]::SetAccessControl($info, $sec) } else { $info.SetAccessControl($sec) }
}

# Deletes $Path, which must lie strictly below $Under, without following any junction or symbolic link: a link is removed
# as an entry, never entered, so a link a guest or anyone else planted never redirects the delete.
function Remove-AapLinTree([string]$Path, [string]$Under) {
    $full = [IO.Path]::GetFullPath($Path).TrimEnd('\'); $root = [IO.Path]::GetFullPath($Under).TrimEnd('\')
    if (-not $full.StartsWith($root + '\', [StringComparison]::OrdinalIgnoreCase)) { throw "AAP_UnsafeDelete: not below its root: $full" }
    $walk = $root
    foreach ($seg in $full.Substring($root.Length + 1).Split('\')) {
        if ((Get-AapLinPathKind $walk) -eq 'link') { throw "AAP_UnsafeDelete: a link: $walk" }   # check:safe-delete
        $walk = Join-Path $walk $seg
    }
    $kind = Get-AapLinPathKind $full
    if ($kind -eq 'absent') { return }
    if ($kind -eq 'dir') { Remove-AapLinTreeInner $full } else { Remove-AapLinEntry $full $kind }
}
function Remove-AapLinTreeInner([string]$Dir) {
    try { $entries = [IO.Directory]::GetFileSystemEntries($Dir) } catch [UnauthorizedAccessException] { Grant-AapLinOwnerAccess $Dir $true; $entries = [IO.Directory]::GetFileSystemEntries($Dir) }
    foreach ($e in $entries) {
        $kind = Get-AapLinPathKind $e
        if ($kind -eq 'dir') { Remove-AapLinTreeInner $e } else { Remove-AapLinEntry $e $kind }
    }
    Remove-AapLinEntry $Dir 'dir'
}
function Remove-AapLinEntry([string]$Path, [string]$Kind) {
    $isDir = $Kind -eq 'dir' -or ($Kind -eq 'link' -and (([int][IO.File]::GetAttributes($Path)) -band [int][IO.FileAttributes]::Directory) -ne 0)
    $once = { if ($isDir) { [IO.Directory]::Delete($Path, $false) } else { [IO.File]::SetAttributes($Path, [IO.FileAttributes]::Normal); [IO.File]::Delete($Path) } }
    try { & $once } catch [UnauthorizedAccessException] { if ($Kind -ceq 'link') { throw }; Grant-AapLinOwnerAccess $Path $isDir; & $once }
}

function Test-AapLinAdmin { (New-Object Security.Principal.WindowsPrincipal ([Security.Principal.WindowsIdentity]::GetCurrent())).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator) }

# A protected DACL for a new entry: SYSTEM and Administrators; the elevated supervisor (or SYSTEM) writes through its
# Administrators entry. Only a token outside Administrators (an unelevated test) adds its own identity, to write what it
# creates: the owner's account SID, which every unelevated process of the owner carries, never gets an entry in
# production. Containers inherit it.
function New-AapLinSecurity([bool]$IsDir, [bool]$Admin = (Test-AapLinAdmin)) {
    $f = $(if ($IsDir) { 'OICI' } else { '' })
    $sddl = "D:P(A;$f;FA;;;SY)(A;$f;FA;;;BA)"
    if (-not $Admin) { $sddl += "(A;$f;FA;;;$([Security.Principal.WindowsIdentity]::GetCurrent().User.Value))" }   # check:own-sid
    $sec = $(if ($IsDir) { New-Object Security.AccessControl.DirectorySecurity } else { New-Object Security.AccessControl.FileSecurity })
    $sec.SetSecurityDescriptorSddlForm($sddl)
    $sec
}
# A new folder with $Security from its creation (no window with an inherited DACL).
function New-AapLinDir([string]$Path, $Security) {
    $ext = 'System.IO.FileSystemAclExtensions' -as [type]
    if ($ext -and $ext.GetMethod('Create', [type[]]@([IO.DirectoryInfo], [Security.AccessControl.DirectorySecurity]))) { [void]$ext::Create([IO.DirectoryInfo]$Path, $Security) }
    else { [void][IO.Directory]::CreateDirectory($Path, $Security) }
}

# Writes one small file of the channel folder whole or not at all: a new temporary file, flushed to disk, then swapped in.
# The folder is the protected one Invoke-AapLinCreate made; the target must be absent or a plain file.
function Write-AapLinFile([string]$Path, [byte[]]$Content) {
    $kind = Get-AapLinPathKind $Path
    if ($kind -cne 'absent' -and $kind -cne 'file') { throw "AAP_UnsafePath: a $kind where a channel file goes: $Path" }   # check:channel-file
    $tmp = $Path + '.tmp'
    if ((Get-AapLinPathKind $tmp) -cne 'absent') { Remove-AapLinEntry $tmp (Get-AapLinPathKind $tmp) }
    $fs = New-Object IO.FileStream($tmp, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::None)
    try { $fs.Write($Content, 0, $Content.Length); $fs.Flush($true) } finally { $fs.Dispose() }
    if ($kind -ceq 'file') { [IO.File]::Replace($tmp, $Path, [NullString]::Value) } else { [IO.File]::Move($tmp, $Path) }
}

# ---- trust: the admin-only definition of backend-lifecycle.md, Trust checks -------------------------------------------

function Test-AapLinReparse([string]$Path) {
    $attr = -1
    try { $attr = [int](New-Object IO.FileInfo $Path).Attributes } catch { $attr = -1 }
    $attr -ne -1 -and ($attr -band [int][IO.FileAttributes]::ReparsePoint) -ne 0
}
function Get-AapLinRawSd([string]$Path) {
    $acl = Get-Acl -LiteralPath $Path
    New-Object Security.AccessControl.RawSecurityDescriptor($acl.GetSecurityDescriptorBinaryForm(), 0)
}

# Get-AapAncestorProblem of install-supervisor.ps1: an admin owner and no other SID that may delete, delete children,
# re-permission or take ownership (create rights are allowed; inherit-only ACEs do not apply to the folder itself).
function Get-AapLinAncestorAclProblem([string]$Dir) {
    $bad = [int]([Security.AccessControl.FileSystemRights]'Delete, DeleteSubdirectoriesAndFiles, ChangePermissions, TakeOwnership') -bor 0x10000000
    try { $raw = Get-AapLinRawSd $Dir } catch { return "cannot read the ACL: $Dir" }
    if ($null -eq $raw.Owner -or $script:AdminSids -notcontains $raw.Owner.Value) { return "owner $($raw.Owner) is not an admin: $Dir" }
    if ($null -eq $raw.DiscretionaryAcl) { return "no DACL (everyone has full control): $Dir" }
    foreach ($ace in $raw.DiscretionaryAcl) {
        $type = [int]$ace.AceType
        if ($type -ne 0 -and $type -ne 1) { return "an ACE that is not a plain allow or deny: $Dir" }
        if ($type -ne 0 -or ([int]$ace.AceFlags -band 8) -ne 0) { continue }
        if ($script:AdminSids -contains $ace.SecurityIdentifier.Value) { continue }
        if (([int]$ace.AccessMask -band $bad) -ne 0) { return "grants $($ace.SecurityIdentifier.Value) delete or re-permission rights: $Dir" }
    }
    $null
}

# The problems of one root: a normalized path on a fixed drive, plain ancestors with admin owners, the root itself a plain
# folder with a trusted owner and a protected DACL, and no ACE for anyone else (-AllowRead: read and execute only, not
# inheritable). An empty list means trusted.
function Get-AapLinTrustProblem($B, [string]$Path, [switch]$AllowRead) {
    $out = New-Object Collections.Generic.List[string]
    if ($Path -notmatch '^[A-Za-z]:\\.+' -or $Path.EndsWith('\') -or [IO.Path]::GetFullPath($Path) -cne $Path) {
        $out.Add("not a normalized absolute path on a drive: $Path")
        return $out.ToArray()
    }
    $fixed = $false
    try { $fixed = (New-Object IO.DriveInfo($Path.Substring(0, 1))).DriveType -eq [IO.DriveType]::Fixed } catch { $fixed = $false }
    if (-not $fixed) { $out.Add("not on a fixed local drive: $Path") }   # check:fixed-drive
    $dir = Split-Path -Parent $Path
    while ($dir) {
        if (Test-AapLinReparse $dir) { $out.Add("reparse point above the root: $dir") }   # check:ancestor-reparse
        elseif (-not $B.Relaxed) { $p = Get-AapLinAncestorAclProblem $dir; if ($p) { $out.Add($p) } }
        $dir = Split-Path -Parent $dir
    }
    if (Test-AapLinReparse $Path) { $out.Add("reparse point: $Path"); return $out.ToArray() }   # check:root-reparse
    if (-not [IO.Directory]::Exists($Path)) { $out.Add("does not exist: $Path"); return $out.ToArray() }
    try { $raw = Get-AapLinRawSd $Path } catch { $out.Add("cannot read the ACL: $Path"); return $out.ToArray() }
    if ($null -eq $raw.Owner -or $B.TrustedSids -notcontains $raw.Owner.Value) { $out.Add("owner $($raw.Owner) is not an admin: $Path") }   # check:root-owner
    if (([int]$raw.ControlFlags -band 0x1000) -eq 0) { $out.Add("inherits its DACL from its parent: $Path") }   # check:acl-protected
    if ($null -eq $raw.DiscretionaryAcl) { $out.Add("no DACL (everyone has full control): $Path"); return $out.ToArray() }
    foreach ($ace in $raw.DiscretionaryAcl) {
        $type = [int]$ace.AceType
        if ($type -ne 0 -and $type -ne 1) { $out.Add("an ACE that is not a plain allow or deny: $Path"); continue }
        if ($type -ne 0) { continue }
        $sid = $ace.SecurityIdentifier.Value
        if ($B.TrustedSids -contains $sid) { continue }
        if (-not $AllowRead) { $out.Add("grants $sid access (it must be admin-only): $Path"); continue }   # check:admin-only
        if ((([int]$ace.AccessMask) -band $script:WriteMask) -ne 0 -or (([int]$ace.AceFlags) -band 3) -ne 0) { $out.Add("grants $sid write or inheritable access: $Path") }   # check:no-write
    }
    $out.ToArray()
}

# A sealed generation entry (P07's read-only signature, images/ubuntu-24.04/INTEGRATION.md): an admin owner, a protected
# DACL, no allow entry for anyone but the admins and Virtual Machines (S-1-5-83-0, read only) and, for the file, the
# ReadOnly attribute. Hyper-V only reads the parent of a differencing disk, so nobody but an administrator may change it.
function Get-AapLinSealedProblem($B, [string]$Path) {
    try { $raw = Get-AapLinRawSd $Path } catch { return "cannot read the ACL: $Path" }
    if ($null -eq $raw.Owner -or $B.TrustedSids -notcontains $raw.Owner.Value) { return "owner $($raw.Owner) is not an admin: $Path" }   # check:sealed-owner
    if (([int]$raw.ControlFlags -band 0x1000) -eq 0) { return "inherits its DACL from its parent: $Path" }   # check:sealed-acl
    if ($null -eq $raw.DiscretionaryAcl) { return "no DACL (everyone has full control): $Path" }
    foreach ($ace in $raw.DiscretionaryAcl) {
        $type = [int]$ace.AceType
        if ($type -ne 0 -and $type -ne 1) { return "an ACE that is not a plain allow or deny: $Path" }
        if ($type -ne 0 -or $B.TrustedSids -contains $ace.SecurityIdentifier.Value) { continue }
        if ($ace.SecurityIdentifier.Value -cne $script:VmGroupSid -or ([int]$ace.AccessMask -band $script:WriteMask) -ne 0) { return "grants $($ace.SecurityIdentifier.Value) more than Virtual Machines read: $Path" }   # check:sealed-acl
    }
    if ((Get-AapLinPathKind $Path) -ceq 'file' -and (([int][IO.File]::GetAttributes($Path)) -band [int][IO.FileAttributes]::ReadOnly) -eq 0) { return "not ReadOnly: $Path" }   # check:sealed-readonly
    $null
}

# -RelaxedTrustForTests trusts the current user and skips the ancestor ACL check (P09's rule): refused for SYSTEM and for
# any folder below ProgramData, Program Files or Windows.
function Get-AapLinRelaxedProblem([string[]]$Paths) {
    if ([Security.Principal.WindowsIdentity]::GetCurrent().User.Value -ceq 'S-1-5-18') { return 'relaxed trust is refused for SYSTEM' }
    $sf = [Environment+SpecialFolder]
    foreach ($d in @($sf::CommonApplicationData, $sf::ProgramFiles, $sf::ProgramFilesX86, $sf::Windows)) {
        $dir = [Environment]::GetFolderPath($d)
        if (-not $dir) { continue }
        foreach ($p in $Paths) { if (($p + '\').StartsWith($dir.TrimEnd('\') + '\', [StringComparison]::OrdinalIgnoreCase)) { return "relaxed trust is for test folders only, never below $dir" } }
    }
    $null
}

# ---- storage document (backend-lifecycle.md, Storage tiers) ----------------------------------------------------------

function Test-AapLinRootForm([string]$Path) {
    if ($Path -cnotmatch '^[A-Za-z]:\\[A-Za-z0-9 ._()\-]+(\\[A-Za-z0-9 ._()\-]+)*\z') { return 'is not an absolute folder below a drive root' }
    foreach ($seg in $Path.Substring(3).Split('\')) {
        if ($seg -eq '.' -or $seg -eq '..') { return 'has a . or .. component' }
        if ($seg -match '[ .]$') { return 'has a component with a trailing dot or space' }
        if ($seg -match $script:Reserved) { return 'names a reserved device' }
    }
    $null
}

function Read-AapLinStorage([string]$Path) {
    if (-not [IO.File]::Exists($Path)) { throw "AAP_StorageMissing: no storage document; the VM profiles stay off until the installer writes one: $Path" }
    if ((New-Object IO.FileInfo $Path).Length -gt 65536) { throw "AAP_StorageInvalid: over 64 KiB: $Path" }
    try { $doc = ConvertFrom-AapLinJson ([IO.File]::ReadAllText($Path)) } catch { throw "AAP_StorageInvalid: not JSON: $Path" }
    if ((Get-AapLinField $doc 'schema') -ne 2 -or (Get-AapLinField $doc 'kind') -cne 'storage') { throw 'AAP_StorageInvalid: not a schema 2 storage document' }
    $floor = Get-AapLinField $doc 'volume_floor_gib'
    if (-not ($floor -is [int] -or $floor -is [long]) -or $floor -lt 10) { throw 'AAP_StorageInvalid: volume_floor_gib must be an integer of at least 10' }
    $s = @{ FloorGib = [int]$floor }
    foreach ($t in 'base_root', 'clone_root', 'scratch_root') {
        $r = Get-AapLinField (Get-AapLinField $doc 'roots') $t
        $p = [string](Get-AapLinField $r 'path'); $g = [string](Get-AapLinField $r 'volume_guid')
        $why = Test-AapLinRootForm $p
        if ($why) { throw "AAP_StorageInvalid: $t $why" }   # check:storage-form
        if ($g -cnotmatch $script:GuidRe) { throw "AAP_StorageInvalid: $t volume_guid is malformed" }
        $s[$t] = @{ Path = $p; Guid = $g }
    }
    $fixed = @('C:\ProgramData\aap-runner', [Environment]::GetFolderPath([Environment+SpecialFolder]::Windows), 'C:\wsl') | Where-Object { $_ }
    foreach ($a in 'base_root', 'clone_root', 'scratch_root') {
        $pa = $s[$a].Path.ToLowerInvariant()
        foreach ($b in 'base_root', 'clone_root', 'scratch_root') {
            if ($a -eq $b) { continue }
            $pb = $s[$b].Path.ToLowerInvariant()
            if ($pa -eq $pb -or $pa.StartsWith($pb + '\')) { throw "AAP_StorageInvalid: $a is equal to or inside $b" }   # check:storage-nesting
        }
        foreach ($f in $fixed) {
            $pf = $f.TrimEnd('\').ToLowerInvariant()
            if ($pa -eq $pf -or $pa.StartsWith($pf + '\') -or $pf.StartsWith($pa + '\')) { throw "AAP_StorageInvalid: $a overlaps $f" }   # check:storage-nesting
        }
    }
    $s
}

# Every tier root's problems, '<tier>: <problem>' (empty = trusted). Run at supervisor start (P12 shows them in
# status.v5.json storage) and before every create. The Linux profile has no scratch disk, but the scratch root is checked
# all the same: it is one of the storage document's roots, and an untrusted one there disables both VM profiles.
function Get-AapLinStorageProblem {
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable]$Backend)
    $B = $Backend
    $out = New-Object Collections.Generic.List[string]
    foreach ($t in 'base_root', 'clone_root', 'scratch_root') {
        $root = $B.Storage[$t]
        foreach ($p in @(Get-AapLinTrustProblem $B $root.Path -AllowRead:($t -ceq 'base_root'))) { $out.Add("${t}: $p") }
        $g = ''
        try { $g = [string](& $B.Provider.GetVolumeGuid @{ Path = $root.Path }) } catch { $g = 'unreadable' }
        if ($g -cne $root.Guid) { $out.Add("${t}: on volume $(Get-AapLinLine $g 40), recorded $($root.Guid)") }   # check:volume
    }
    $out.ToArray()
}

function Get-AapLinHostProblem {
    <# The host settings a Linux VM profile needs: Enhanced Session Mode off (it opens an interactive console channel
       into every guest), and nobody in Hyper-V Administrators (S-1-5-32-578) but SYSTEM and Administrators (a member can
       drive every VM, read its disks and connect to its hvsocket services). 'AAP_<Reason>: detail' lines, empty =
       trusted. Run at supervisor start (P12 shows them and keeps the VM profiles off) and before every create. #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable]$Backend)
    $out = New-Object Collections.Generic.List[string]
    try { $h = & $Backend.Provider.GetHostSecurity @{} } catch { $out.Add("AAP_HostUnreadable: $(Get-AapLinError $_)"); return $out.ToArray() }
    if ((Get-AapLinField $h 'EnhancedSessionMode') -ne $false) { $out.Add('AAP_EnhancedSession: Enhanced Session Mode is not off on this Hyper-V host') }   # check:enhanced-session
    $members = Get-AapLinField $h 'HyperVAdmins'
    if ($null -eq $members) { $out.Add('AAP_HostUnreadable: the members of Hyper-V Administrators are unknown') }
    foreach ($sid in @($members | Where-Object { $null -ne $_ })) {
        if ($script:AdminSids -cnotcontains [string]$sid) { $out.Add("AAP_HyperVAdmins: $(Get-AapLinLine ([string]$sid) 80) is a member of Hyper-V Administrators") }   # check:hyperv-admins
    }
    $out.ToArray()
}

# ---- journal ----------------------------------------------------------------------------------------------------------

function Get-AapLinVmName($r) { Get-AapVmName -Profile linux -Slot ([int]$r.slot) -LeaseGeneration ([long]$r.lease_generation) -ReservationId ([string]$r.reservation_id) }
function Get-AapLinJournalPath($B, $r) { Join-Path $B.JournalRoot ([string]$r.reservation_id + '.jsonl') }

# Appends one `op` record and flushes it to disk before the caller acts (intent) or moves on (done, failed). A last line
# without its newline is a write a crash cut short: it is cut off first, so the new record never joins it.
function Write-AapLinJournal($B, $r, [string]$Op, [string]$Phase, [string]$VmId = '', [object[]]$Disks = @(), [string]$Code = '', [string]$Detail = '', $At = $null, $LifetimeCap = $null) {
    $result = $null
    if ($Phase -cne 'intent') { $result = [ordered]@{ code = $Code; detail = (Get-AapLinLine $Detail 200) } }
    $vm = $null
    if ($VmId) { $vm = $VmId }
    if ($null -eq $At) { $At = Get-AapLinNow $B }
    $rec = [ordered]@{
        schema = 2; kind = 'op'; reservation_id = [string]$r.reservation_id; lease_generation = [long]$r.lease_generation
        backend = 'hyperv-vm'; profile = 'linux'; image_generation = [string]$r.image_generation; op = $Op
        idempotency_key = ('{0}/{1}/{2}' -f $r.reservation_id, $r.lease_generation, $Op); phase = $Phase; at = (Format-AapLinTime $At)
        vm = [ordered]@{ vm_id = $vm; vm_name = (Get-AapLinVmName $r) }; disks = [object[]]$Disks; result = $result
    }
    if ($null -ne $LifetimeCap) { $rec.lifetime_cap = $LifetimeCap }
    $bytes = $script:Utf8.GetBytes((ConvertTo-Json -InputObject $rec -Depth 6 -Compress) + "`n")
    $fs = New-Object IO.FileStream((Get-AapLinJournalPath $B $r), [IO.FileMode]::OpenOrCreate, [IO.FileAccess]::ReadWrite, [IO.FileShare]::Read)
    try {
        $keep = $fs.Length
        while ($keep -gt 0) { $fs.Position = $keep - 1; if ($fs.ReadByte() -eq 10) { break }; $keep-- }
        if ($keep -ne $fs.Length) { $fs.SetLength($keep); $fs.Flush($true) }   # check:journal-torn
        $fs.Position = $fs.Length
        $fs.Write($bytes, 0, $bytes.Length)
        $fs.Flush($true)
    } finally { $fs.Dispose() }
}

# A failed record, unless the journal's last record says exactly the same: a teardown that keeps failing the same way (a
# pending release, a VM that will not go) does not grow the journal toward its size bound.
function Write-AapLinFailedOnce($B, $r, $j, [string]$Op, [string]$VmId, [string]$Code, [string]$Detail) {
    if ($j.Last -ceq "$Op/failed/$Code/$(Get-AapLinLine $Detail 200)") { return }   # check:journal-dedup
    Write-AapLinJournal $B $r $Op 'failed' -VmId $VmId -Code $Code -Detail $Detail
}

# The facts the steps need, from the journal. Throws AAP_JournalUnreadable on anything but well-formed records of this
# reservation and lease generation. A last line without its newline was torn by a crash mid-append: that write never
# completed, so neither did its act (intent), or only the act's record is missing (done, failed); both re-run safely, and
# the next append cuts it off. Last is '<op>/<phase>/<code>/<detail>' of the last record.
function Read-AapLinJournal($B, $r) {
    # Open: the ops whose last record is an intent. Cap: the lifetime_cap evidence of a destroy intent (the durable latch).
    $f = @{ Has = @{}; VmId = $null; LeaseId = $null; LeaseIssued = $false; Started = $false; DrainedOnline = $false; BootAt = $null; RunOneAt = $null
        Hostile = $null; LastDestroyFail = $null; Last = ''; Open = @{}; Cap = $null
    }
    $path = Get-AapLinJournalPath $B $r
    $kind = Get-AapLinPathKind $path
    if ($kind -eq 'absent') { return $f }
    if ($kind -ne 'file' -or (New-Object IO.FileInfo $path).Length -gt $script:JournalMax) { throw 'AAP_JournalUnreadable: not a plain file within its size bound' }   # check:journal-shape
    $lines = [IO.File]::ReadAllText($path, (New-Object Text.UTF8Encoding($false, $true))).Split("`n")
    for ($i = 0; $i -lt $lines.Length - 1; $i++) {
        try { $rec = ConvertFrom-AapLinJson $lines[$i] } catch { throw "AAP_JournalUnreadable: line $($i + 1) is not JSON" }
        $op = [string](Get-AapLinField $rec 'op'); $phase = [string](Get-AapLinField $rec 'phase')
        $mine = (Get-AapLinField $rec 'kind') -ceq 'op' -and [string](Get-AapLinField $rec 'reservation_id') -ceq [string]$r.reservation_id -and
            [long](Get-AapLinField $rec 'lease_generation') -eq [long]$r.lease_generation -and (Get-AapLinField $rec 'profile') -ceq 'linux' -and
            $script:Ops -ccontains $op -and @('intent', 'done', 'failed') -ccontains $phase
        if (-not $mine) { throw "AAP_JournalUnreadable: line $($i + 1) is not a record of this lease" }   # check:journal-owner
        $f.Has["$op/$phase"] = $true
        $at = Get-AapLinField $rec 'at'
        $vmId = Get-AapLinField (Get-AapLinField $rec 'vm') 'vm_id'
        if ($vmId) { $f.VmId = [string]$vmId }
        $res = Get-AapLinField $rec 'result'
        $code = [string](Get-AapLinField $res 'code'); $detail = [string](Get-AapLinField $res 'detail')
        if ($op -ceq 'ready' -and $phase -ceq 'done' -and $detail -cmatch 'lease (l-[0-9a-f]{32})\z') { $f.LeaseId = $Matches[1] }
        if ($op -ceq 'ready' -and $phase -ceq 'done' -and $script:LeaseAnswers -ccontains $detail) { $f.LeaseIssued = $true }
        if ($op -ceq 'ready' -and $phase -ceq 'done' -and $detail -ceq $script:StartedDetail) { $f.Started = $true }
        if ($op -ceq 'drain' -and $phase -ceq 'done' -and $detail -ceq $script:DrainOnline) { $f.DrainedOnline = $true }
        $f.Last = "$op/$phase/$code/$detail"
        $f.Open[$op] = $phase -ceq 'intent'
        $cap = Get-AapLinField $rec 'lifetime_cap'
        if ($null -ne $cap) { $f.Cap = $cap }
        if ($op -ceq 'boot' -and $phase -ceq 'done') { $f.BootAt = ConvertTo-AapLinUtc $at }
        if ($op -ceq 'run_one' -and $phase -ceq 'intent' -and $null -eq $f.RunOneAt) { $f.RunOneAt = ConvertTo-AapLinUtc $at }
        if ($code -ceq 'hostile_guest') { $f.Hostile = $detail }
        if ($op -ceq 'destroy' -and $phase -ceq 'failed') { $f.LastDestroyFail = ConvertTo-AapLinUtc $at }
    }
    $f
}

# ---- allocator --------------------------------------------------------------------------------------------------------

function Get-AapLinAllocArgs($B, $r) {
    $a = @{ Root = $B.AllocatorRoot; ReservationId = [string]$r.reservation_id; LeaseGeneration = [long]$r.lease_generation }
    foreach ($k in $B.AllocArgs.Keys) { $a[$k] = $B.AllocArgs[$k] }
    $a
}

function Set-AapLinState($B, $r, [string]$State, [string]$Kind = '', [string]$Reason = '', [string]$VmId = '') {
    $a = Get-AapLinAllocArgs $B $r
    $a.State = $State
    if ($Kind) { $a.QuarantineKind = $Kind; $a.Reason = $Reason }
    if ($VmId) { $a.VmId = $VmId }
    Set-AapSlotState @a
}

# Walks the legal edges from the reservation's state down to $To (draining, collecting or deleting). Returns the
# reservation as the allocator now holds it, or $null when the allocator refused or failed an edge.
function Move-AapLinState($B, $r, [string]$To, [string]$VmId = '') {
    $path = $script:Down[[string]$r.state]
    if (-not $path) { return $r }
    foreach ($s in $path) {
        $res = Set-AapLinState $B $r $s -VmId $(if ($r.state -ceq 'creating') { $VmId } else { '' })
        if (-not $res.Ok) { return $null }
        $next = Get-AapLinField $res 'Reservation'
        if ($null -ne $next) { $r = $next }
        if ($s -ceq $To) { break }
    }
    $r
}

# ---- the per-clone seed (guest-transport.md, Linux candidate; images/ubuntu-24.04/INTEGRATION.md, P11) --------------------

function New-AapLinSeed {
    <# The cloud-init NoCloud seed of one clone: the files user-data and meta-data, as text, for a host-built ISO 9660 +
       Joliet image labelled CIDATA (the provider's NewSeedImage writes it; nothing is ever written into the clone's disk
       from the host). It holds only public material: the VM name, a fresh instance id, the job user and the PUBLIC half of
       the per-clone management key, in root's authorized_keys behind restrict and the forced agent command, so the key can
       start the agent and nothing else. Never a private key, a JIT config, a registration token, a password or a host
       key. The job user is runner (uid 1001, as on the hosted image); no account gets uid 1000 (the image's removed
       install user had it) and cloud-init's default user is not created. Root may log in with the forced command only
       (sshd PermitRootLogin forced-commands-only, the image's part, P15). The seed is ejected and deleted once the guest
       answers its first probe.
       network-config: the guest's static addressing, from the declaration the P10.0 module's Attach returned for this VM
       (host-network-module.md, Consumer obligations 1): its address with the subnet's prefix length, the gateway as the
       default route, the resolvers as its DNS servers, no DHCP and no router advertisements, on the one hv_netvsc
       interface (matched by driver: Hyper-V may assign the MAC address at first start). Nothing on the host serves DHCP. #>
    param([Parameter(Mandatory)][string]$VmName, [Parameter(Mandatory)][string]$InstanceId, [Parameter(Mandatory)][string]$PublicKey,
        [Parameter(Mandatory)]$Network, $ReservationId = $null, $LeaseGeneration = $null)
    if ($VmName -cnotmatch $script:VmNameRe -or $InstanceId -cnotmatch '^[a-z0-9-]{1,64}\z' -or $PublicKey -cnotmatch $script:Ed25519Re) { throw 'AAP_SeedInvalid: the VM name, instance id or public key' }   # check:seed-values
    # Only a declaration the shared check accepts for this VM name becomes YAML: every value is then a canonical address.
    $req = @{ VmId = [string](Get-AapLinField $Network 'vm_id'); VmName = $VmName; Profile = 'linux' }
    $bad = @(Get-AapHostNetworkDeclarationProblems -Request $req -Declaration $Network)
    if ($bad.Count) { throw "AAP_SeedInvalid: the network declaration: $(Get-AapLinLine ($bad -join '; ') 160)" }   # check:seed-network
    $vmId = Get-AapLinField $Network 'vm_id'
    if ($vmId -isnot [string] -or $vmId -cnotmatch $script:GuidRe -or $ReservationId -isnot [string] -or $ReservationId -cnotmatch $script:RidRe -or -not ($LeaseGeneration -is [int] -or $LeaseGeneration -is [long]) -or $LeaseGeneration -lt 1 -or $LeaseGeneration -gt 999999999) {   # check:seed-identity
        throw 'AAP_SeedInvalid: identity record: vm_id, reservation_id or lease_generation'
    }
    # Closed canonical JSON, from validated parts only. A YAML comment is ignored by cloud-init, not a private YAML key.
    $identity = '{"schema":2,"kind":"guest_identity","vm_id":"' + $vmId + '","reservation_id":"' + $ReservationId + '","lease_generation":' + $LeaseGeneration.ToString($script:Inv) + ',"scratch":null}'
    # The lines below put these values into YAML unquoted. That is safe only because the shared check above accepts
    # canonical dotted IPv4 (and a prefix length of digits) and nothing else; checked again here, so a looser shared
    # check can never write a line of its own into the guest's network-config.
    $address = [string](Get-AapLinField $Network 'address')
    $gateway = [string](Get-AapLinField $Network 'gateway')
    $subnet = ([string](Get-AapLinField $Network 'subnet')).Split('/')
    $dns = Get-AapLinField $Network 'resolvers'   # one array: the field keeps it in one piece
    $dns = @($dns | ForEach-Object { [string]$_ })
    $ip = '^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\z'
    if ($subnet.Count -ne 2 -or $subnet[1] -cnotmatch '^[0-9]{1,2}\z' -or @(@($address, $gateway, $subnet[0]) + $dns | Where-Object { $_ -cnotmatch $ip }).Count) {   # check:seed-yaml
        throw 'AAP_NetworkInvalid: a network value for the seed is not a dotted IPv4 address or prefix length'
    }
    $bits = $subnet[1]
    $networkConfig = (@(
            'version: 2'
            'ethernets:'
            '  aap0:'
            '    match:'
            '      driver: hv_netvsc'
            '    dhcp4: false'
            '    dhcp6: false'
            '    accept-ra: false'
            '    link-local: []'
            "    addresses: [$address/$bits]"
            '    routes:'
            '      - to: default'
            "        via: $gateway"
            '    nameservers:'
            "      addresses: [$($dns -join ', ')]"
        ) -join "`n") + "`n"
    $userData = @"
#cloud-config
# aap-guest-identity: $identity
hostname: $VmName
preserve_hostname: false
disable_root: false
ssh_pwauth: false
ssh_deletekeys: true
ssh_genkeytypes: [ed25519]
users:
  - name: runner
    uid: 1001
    groups: [adm, users, docker, systemd-journal]
    shell: /bin/bash
    lock_passwd: true
    sudo: 'ALL=(ALL) NOPASSWD:ALL'
write_files:
  - path: /root/.ssh/authorized_keys
    owner: root:root
    permissions: '0600'
    content: |
      restrict,command="$($script:Agent)" $PublicKey aap-management

"@
    [ordered]@{ 'user-data' = $userData.Replace("`r`n", "`n"); 'meta-data' = "instance-id: $InstanceId`nlocal-hostname: $VmName`n"; 'network-config' = $networkConfig }
}

# ---- the guest channel: OpenSSH over a Hyper-V socket (guest-transport.md, Linux candidate) --------------------------------

function Get-AapLinCloneDir($B, $r) { Join-Path $B.Storage.clone_root.Path ([string]$r.reservation_id) }
function Get-AapLinSshDir($B, $r) { Join-Path (Get-AapLinCloneDir $B $r) 'ssh' }

# A path for ssh_config: forward slashes, and nothing ssh would expand or split (% tokens, quotes, control bytes).
function ConvertTo-AapLinSshPath([string]$Path) {
    if ($Path -cmatch '[%"\x00-\x1f\x7f]' -or $Path -cnotmatch '^[A-Za-z]:\\') { throw "AAP_UnsafePath: a path ssh would expand or split: $Path" }   # check:ssh-path
    $Path.Replace('\', '/')
}

# The per-clone client configuration (security review M4): ssh.exe -F <this file> -T aap-guest. Key-only, batch,
# no agent, no forwarding of any kind, no local command, no tty, the pinned per-clone known_hosts and an empty global one,
# and the relay as ProxyCommand by absolute path: it connects an AF_HYPERV socket to this VM id and the runtime service.
function Write-AapLinSshConfig([string]$Dir, [string]$VmId) {
    if ($VmId -cnotmatch $script:GuidRe) { throw 'AAP_Unexpected: the VM id is not a GUID' }
    foreach ($p in $script:RelayExe, $script:RelayScript) { if ($p -cmatch '[%"\x00-\x1f\x7f]') { throw "AAP_UnsafePath: the relay path holds a character ssh would expand: $p" } }
    $text = (@(
            'Host aap-guest'
            "  HostName $VmId"
            '  User root'
            "  ProxyCommand `"$($script:RelayExe)`" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File `"$($script:RelayScript)`" $VmId"
            "  IdentityFile `"$(ConvertTo-AapLinSshPath (Join-Path $Dir 'id_ed25519'))`""
            "  UserKnownHostsFile `"$(ConvertTo-AapLinSshPath (Join-Path $Dir 'known_hosts'))`""
            "  GlobalKnownHostsFile `"$(ConvertTo-AapLinSshPath (Join-Path $Dir 'known_hosts_global'))`""
            '  HostKeyAlias aap-guest'
            '  HostKeyAlgorithms ssh-ed25519'
            '  StrictHostKeyChecking yes'
            '  UpdateHostKeys no'
            '  CheckHostIP no'
            '  VerifyHostKeyDNS no'
            '  IdentitiesOnly yes'
            '  IdentityAgent none'
            '  PubkeyAuthentication yes'
            '  PasswordAuthentication no'
            '  KbdInteractiveAuthentication no'
            '  GSSAPIAuthentication no'
            '  HostbasedAuthentication no'
            '  BatchMode yes'
            '  ForwardAgent no'
            '  ForwardX11 no'
            '  ClearAllForwardings yes'
            '  Tunnel no'
            '  PermitLocalCommand no'
            '  RequestTTY no'
            '  EscapeChar none'
            '  ControlMaster no'
            '  ControlPath none'
            '  LogLevel QUIET'
        ) -join "`n") + "`n"
    Write-AapLinFile (Join-Path $Dir 'ssh_config') ([Text.Encoding]::ASCII.GetBytes($text))
    if ((Get-AapLinPathKind (Join-Path $Dir 'known_hosts_global')) -ceq 'absent') { Write-AapLinFile (Join-Path $Dir 'known_hosts_global') ([byte[]]@()) }
}

# The guest's host key, pinned once: before the first SSH command, from the guest's own first boot (guest-transport.md:
# the guest publishes it through Key-Value Pair Exchange, guest to host). Pinned means known_hosts exists.
function Test-AapLinPinned($g) { (Get-AapLinPathKind (Join-Path $g.Dir 'known_hosts')) -ceq 'file' }

# The channel's seq high-water mark: every seq ever sent is at most the number in ssh\seq, written before the first send
# past it (a block of SeqBlock at a time), so a restarted supervisor continues above every seq it sent before. Create
# writes 0 with the key pair, so a channel always has its mark: a missing one is as lost as a damaged one ($null).
function Read-AapLinSeq([string]$Dir) {
    $p = Join-Path $Dir 'seq'
    if ((Get-AapLinPathKind $p) -cne 'file' -or (New-Object IO.FileInfo $p).Length -gt 16) { return $null }
    $t = [Text.Encoding]::ASCII.GetString([IO.File]::ReadAllBytes($p))
    if ($t -cnotmatch '^[0-9]{1,10}\z' -or [long]$t -gt $script:SeqMax) { return $null }   # check:seq-file
    [long]$t
}

# This process's guest record for a reservation: from memory, or rebuilt from the clone's ssh folder after a restart
# (the private key, the pin and the seq mark persist there). $null when there is no usable channel: before create is
# done, or with a key, configuration or seq mark missing or unreadable (fail closed: the steps then treat the guest as
# unreachable, as the Windows twin does after a restart).
function Get-AapLinGuest($B, $r, $j) {
    $rid = [string]$r.reservation_id
    if ($B.Guests.ContainsKey($rid)) { return $B.Guests[$rid] }
    if (-not $j.Has['create/done'] -or -not $j.VmId) { return $null }
    $dir = Get-AapLinSshDir $B $r
    try {
        Assert-AapLinPlainPath -Root $B.Storage.clone_root.Path -Path $dir -Reason 'AAP_UnsafePath'
        if ((Get-AapLinPathKind $dir) -cne 'dir' -or (Get-AapLinPathKind (Join-Path $dir 'id_ed25519')) -cne 'file') { return $null }
        $seq = Read-AapLinSeq $dir
        if ($null -eq $seq) { return $null }   # check:seq-absent
        Write-AapLinSshConfig $dir ([string]$j.VmId)
    } catch { return $null }
    $g = @{ VmId = [string]$j.VmId; Dir = $dir; Seq = $seq; Ceiling = $seq; Started = [bool]$j.Started; Hostile = $j.Hostile }
    $B.Guests[$rid] = $g
    $g
}

# Checks one transport result against the command it answers. Kind: ok, refused, error (a valid reply whose status says
# so), timeout, no_reply (a failed guest) or hostile (Code: a fixed code; the host never keeps guest text as a reason).
# ssh.exe's own failure (exit 255: the relay could not connect, the pinned host key or the key was refused, the connection
# dropped) is a failed guest whatever it printed: a guest that breaks its channel gains nothing it could not get by staying
# silent. Any other non-zero exit is the agent breaking the contract.
function Test-AapLinReply($Raw, $Cmd) {
    $v = @{ Kind = 'hostile'; Code = $null; Reply = $null }
    if ($null -eq $Raw) { $v.Kind = 'no_reply'; return $v }
    $out = Get-AapLinField $Raw 'Stdout'; $exit = Get-AapLinField $Raw 'ExitCode'
    if ([bool](Get-AapLinField $Raw 'Overflow')) { $v.Code = 'oversized_reply'; return $v }   # check:reply-size
    if ([bool](Get-AapLinField $Raw 'TimedOut')) { $v.Kind = 'timeout'; return $v }
    if ($exit -is [int] -and $exit -eq $script:SshFailure) { $v.Kind = 'no_reply'; return $v }   # check:transport-drop
    if (-not ($exit -is [int]) -or $exit -ne 0) { $v.Code = 'child_exit'; return $v }   # check:child-exit
    if (-not ($out -is [byte[]]) -or $out.Length -eq 0) { $v.Kind = 'no_reply'; return $v }
    $n = $out.Length
    if ($out[$n - 1] -eq 10) { $n-- }
    if ($n -gt $script:ReplyMax) { $v.Code = 'oversized_reply'; return $v }   # check:reply-size
    for ($i = 0; $i -lt $n; $i++) {
        if ($out[$i] -lt 0x20 -or $out[$i] -gt 0x7e) { $v.Code = 'non_printable'; return $v }   # check:printable
    }
    $doc = ConvertFrom-AapBrokerJson ([Text.Encoding]::ASCII.GetString($out, 0, $n))
    if ($null -eq $doc) { $v.Code = 'bad_json'; return $v }   # check:reply-json
    $keys = @($doc.Keys)
    if ($keys.Count -ne $script:ReplyKeys.Count -or @($keys | Where-Object { $script:ReplyKeys -cnotcontains $_ }).Count) { $v.Code = 'extra_fields'; return $v }   # check:reply-fields
    $int = { param($x) $x -is [long] -or $x -is [int] }
    $exitCode = $doc['runner_exit_code']
    $ok = (& $int $doc['schema']) -and $doc['schema'] -eq 1 -and $doc['kind'] -ceq 'guest_reply' -and
        $doc['vm_id'] -is [string] -and $doc['vm_id'] -cmatch $script:GuidRe -and $doc['reservation_id'] -is [string] -and $doc['reservation_id'] -cmatch $script:RidRe -and
        (& $int $doc['lease_generation']) -and (& $int $doc['seq']) -and $doc['nonce'] -is [string] -and $doc['nonce'] -cmatch '^[0-9a-f]{32}\z' -and
        $doc['status'] -is [string] -and @('ok', 'refused', 'error') -ccontains $doc['status'] -and
        $doc['guest_state'] -is [string] -and $script:GuestStates -ccontains $doc['guest_state'] -and
        ($null -eq $exitCode -or ((& $int $exitCode) -and $exitCode -ge [int]::MinValue -and $exitCode -le [int]::MaxValue)) -and
        $doc['diag'] -is [string] -and $doc['diag'].Length -le 512
    if (-not $ok) { $v.Code = 'bad_value'; return $v }   # check:reply-values
    foreach ($k in 'vm_id', 'reservation_id', 'lease_generation', 'seq', 'nonce') {
        if ([string]$doc[$k] -cne [string]$Cmd[$k]) { $v.Code = 'wrong_echo'; return $v }   # check:reply-echo
    }
    if ($doc['diag'] -cmatch $script:SecretValue) { $v.Code = 'secret_value'; return $v }   # check:reply-secret
    $v.Reply = $doc
    if ($doc['status'] -cne 'ok') { $v.Kind = [string]$doc['status']; return $v }
    if ($script:Answers[[string]$Cmd['cmd']] -cnotcontains $doc['guest_state']) { $v.Code = 'bad_state'; return $v }   # check:reply-state
    $v.Kind = 'ok'
    $v
}

# Sends one command to the reservation's guest. The VM, the reservation and the lease generation come from this
# process's own records, never from the guest; seq grows by one per send, including a send that times out or fails, and
# is never reused, also across a supervisor restart (the seq mark is written before the first send past it), so a command
# the guest never saw or whose reply was lost leaves a gap the agent accepts (guest-transport.md, Sequence rule: any seq
# strictly greater than the last accepted one); the nonce is fresh. A reply must echo this command's seq and nonce, or it
# is hostile (wrong_echo). A JIT config ($Jit, the broker's object) is written by the transport straight onto the call
# child's stdin and never becomes text here. Nothing is sent before the guest's host key is pinned: an unusable channel
# folder is a guest that cannot be reached (no_reply), never an exception that would stall the slot.
function Invoke-AapLinCommand($B, $r, [string]$Cmd, $Jit = $null) {
    $g = $B.Guests[[string]$r.reservation_id]
    $none = @{ Kind = 'no_reply'; Code = 'channel_unusable'; Reply = $null }
    $plain = $true
    try { Assert-AapLinPlainPath -Root $B.Storage.clone_root.Path -Path $g.Dir -Reason 'AAP_UnsafePath' } catch { $plain = $false }
    # Nothing is sent before the guest's host key is pinned, nor through a channel folder that is not a plain folder.
    if (-not $plain -or (Get-AapLinPathKind $g.Dir) -cne 'dir' -or -not (Test-AapLinPinned $g)) { return $none }   # check:pin-first
    $g.Seq = [long]$g.Seq + 1
    if ($g.Seq -gt $script:SeqMax) { throw 'AAP_BadCommand: seq would pass 2^31-1' }
    if ($g.Seq -gt $g.Ceiling) {   # check:seq-mark
        # The mark first: a seq the mark does not cover is never sent.
        $mark = [Math]::Min($script:SeqMax, [long]$g.Seq + $script:SeqBlock - 1)
        try { Write-AapLinFile (Join-Path $g.Dir 'seq') ([Text.Encoding]::ASCII.GetBytes([string]$mark)) } catch { return $none }
        $g.Ceiling = $mark
    }
    $timeout = $script:Timeouts[$Cmd]
    $len = 0
    if ($null -ne $Jit) { $len = [int]$Jit.Length }
    $c = [ordered]@{ vm_id = $g.VmId; reservation_id = [string]$r.reservation_id; lease_generation = [long]$r.lease_generation; seq = [long]$g.Seq
        nonce = (New-AapLinHex 16); cmd = $Cmd; payload_bytes = $len; expires_at = (Format-AapLinTime (Get-AapLinNow $B).AddSeconds($timeout))
    }
    $doc = [ordered]@{ schema = 1; kind = 'host_cmd' }
    foreach ($k in $c.Keys) { $doc[$k] = $c[$k] }
    $line = ConvertTo-Json -InputObject $doc -Compress
    if ($c.vm_id -cnotmatch $script:GuidRe -or $line.Length -gt $script:EnvelopeMax -or $len -gt $script:PayloadMax -or ($Cmd -ceq 'deliver_registration') -ne ($len -gt 0)) {
        throw 'AAP_BadCommand: the envelope breaks guest-transport.md'
    }
    $call = @{ VmId = $g.VmId; Config = (Join-Path $g.Dir 'ssh_config'); Envelope = $line; PayloadLength = $len; WritePayload = $null; TimeoutSeconds = $timeout }
    if ($null -ne $Jit) { $call.WritePayload = { param([IO.Stream]$Stream) $Jit.WriteTo($Stream) }.GetNewClosure() }
    $raw = $null
    try { $raw = & $B.Transport $call } catch { $raw = $null }
    $v = Test-AapLinReply $raw $c
    if ($v.Kind -ceq 'hostile') { $g.Hostile = $v.Code }
    $v
}

# Compiled once by New-AapLinBackend with %TMP% pointed at an admin-only folder (never the operator's %TEMP%): the job
# object for the call child, and the ISO writer the production provider uses for seed images (IMAPI2's result stream copied
# block by block into a file created new; P07's writer).
$script:TypeSource = @'
using System;
using System.ComponentModel;
using System.IO;
using System.Runtime.InteropServices;
public static class AapLinJobObject {
    [StructLayout(LayoutKind.Sequential)]
    struct Basic { public long PerProcessUserTimeLimit; public long PerJobUserTimeLimit; public uint LimitFlags; public UIntPtr MinimumWorkingSetSize; public UIntPtr MaximumWorkingSetSize; public uint ActiveProcessLimit; public UIntPtr Affinity; public uint PriorityClass; public uint SchedulingClass; }
    [StructLayout(LayoutKind.Sequential)]
    struct Counters { public ulong ReadOps; public ulong WriteOps; public ulong OtherOps; public ulong ReadBytes; public ulong WriteBytes; public ulong OtherBytes; }
    [StructLayout(LayoutKind.Sequential)]
    struct Extended { public Basic Limits; public Counters Io; public UIntPtr ProcessMemoryLimit; public UIntPtr JobMemoryLimit; public UIntPtr PeakProcessMemoryUsed; public UIntPtr PeakJobMemoryUsed; }
    [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)] static extern IntPtr CreateJobObjectW(IntPtr attributes, string name);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool SetInformationJobObject(IntPtr job, int infoClass, ref Extended info, int length);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool AssignProcessToJobObject(IntPtr job, IntPtr process);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool TerminateJobObject(IntPtr job, uint exitCode);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool CloseHandle(IntPtr handle);
    // A job under the name the relay checks its membership against (hvsock-relay.ps1): kill on close (0x2000), job memory
    // (0x200), job CPU time (0x4), no error dialog on a crash (0x400).
    public static IntPtr Create(string name, long memoryBytes, long cpuSeconds) {
        IntPtr job = CreateJobObjectW(IntPtr.Zero, name);
        if (job == IntPtr.Zero) throw new Win32Exception();
        Extended info = new Extended();
        info.Limits.LimitFlags = 0x2000 | 0x200 | 0x4 | 0x400;
        info.Limits.PerJobUserTimeLimit = cpuSeconds * 10000000L;
        info.JobMemoryLimit = new UIntPtr((ulong)memoryBytes);
        if (!SetInformationJobObject(job, 9, ref info, Marshal.SizeOf(typeof(Extended)))) {
            int e = Marshal.GetLastWin32Error();
            CloseHandle(job);
            throw new Win32Exception(e);
        }
        return job;
    }
    public static void Assign(IntPtr job, IntPtr process) { if (!AssignProcessToJobObject(job, process)) throw new Win32Exception(); }
    public static void Kill(IntPtr job) { TerminateJobObject(job, 1); }
    public static void Close(IntPtr job) { CloseHandle(job); }
}
public static class AapLinIsoWriter {
    // Every read must fill its block: a short one would leave stale bytes in an image of the right size. Returns the
    // SHA-256 of what was written, which the backend checks the file on disk against.
    public static string Save(object stream, string path, int blockSize, int blocks) {
        System.Runtime.InteropServices.ComTypes.IStream s = (System.Runtime.InteropServices.ComTypes.IStream)stream;
        IntPtr got = Marshal.AllocCoTaskMem(4);
        try {
            using (System.Security.Cryptography.SHA256 sha = System.Security.Cryptography.SHA256.Create())
            using (FileStream fs = new FileStream(path, FileMode.CreateNew, FileAccess.Write, FileShare.None)) {
                byte[] buf = new byte[blockSize];
                for (int i = 0; i < blocks; i++) {
                    Marshal.WriteInt32(got, 0);
                    s.Read(buf, blockSize, got);
                    if (Marshal.ReadInt32(got) != blockSize) throw new IOException("AAP_SeedInvalid: a short read from the image stream");
                    sha.TransformBlock(buf, 0, blockSize, null, 0);
                    fs.Write(buf, 0, blockSize);
                }
                sha.TransformFinalBlock(buf, 0, 0);
                fs.Flush(true);
                return BitConverter.ToString(sha.Hash).Replace("-", "").ToLowerInvariant();
            }
        } finally { Marshal.FreeCoTaskMem(got); }
    }
}
'@

# Windows PowerShell 5.1 (.NET Framework) builds a redirected stdin writer from [Console]::InputEncoding and writes its
# preamble at Process.Start: under code page 65001 the child would read EF BB BF before the envelope. Start under a
# preamble-free encoding and restore it; without a console there is nothing to swap.
function Start-AapLinProcess([Diagnostics.ProcessStartInfo]$Psi) {
    $saved = $null
    try { $saved = [Console]::InputEncoding } catch { $null = $_ }
    if ($null -ne $saved) {   # check:stdin-bom
        try { [Console]::InputEncoding = New-Object Text.UTF8Encoding($false) } catch { $saved = $null }
    }
    try { [Diagnostics.Process]::Start($Psi) } finally { if ($null -ne $saved) { try { [Console]::InputEncoding = $saved } catch { $null = $_ } } }
}

# The default transport: one hidden ssh.exe per command, by absolute path, with a fixed command line that names only the
# per-clone configuration file, inside a job object with a memory cap, a CPU-time cap and kill-on-close; the wall cap is
# the command's timeout plus 10 s, session setup included. ssh.exe is put in the job just after it starts, and its
# ProxyCommand relay talks to the guest only from inside that job (named in AAP_RELAY_JOB, which ssh.exe passes on): a
# relay started before the assignment refuses (hvsock-relay.ps1), ssh.exe fails (255) and the command is a failed guest
# the next one retries. Its stdin gets the envelope line and then exactly the payload, which ssh carries to the forced
# agent command; at most 8193 bytes of its stdout are read, and stderr is drained through a 4 KiB buffer and dropped,
# never parsed.
function Invoke-AapLinGuestChild([hashtable]$Call) {
    if (-not ('AapLinJobObject' -as [type])) { throw 'AAP_ChildUncapped: the job object type is compiled by New-AapLinBackend' }
    $psi = New-Object Diagnostics.ProcessStartInfo
    $psi.FileName = $script:ChildExe
    $psi.Arguments = $script:ChildArgs -f $Call.Config
    $psi.UseShellExecute = $false
    $psi.CreateNoWindow = $true
    $psi.RedirectStandardInput = $true
    $psi.RedirectStandardOutput = $true
    $psi.RedirectStandardError = $true
    $psi.EnvironmentVariables['PSModulePath'] = [Environment]::GetEnvironmentVariable('PSModulePath', 'Machine')
    $name = 'aap-lin-call-' + (New-AapLinHex 16)
    $psi.EnvironmentVariables[$script:RelayJobVar] = $name
    $wall = [int]$Call.TimeoutSeconds + 10
    $deadline = [DateTime]::UtcNow.AddSeconds($wall)
    $buf = New-Object byte[] $script:ReadMax
    $n = 0
    $job = [IntPtr]::Zero
    try { $job = [AapLinJobObject]::Create($name, $script:ChildMemoryBytes, $wall) } catch { throw 'AAP_ChildUncapped: the job object for the call child could not be made' }
    try { $p = Start-AapLinProcess $psi } catch { [AapLinJobObject]::Close($job); throw }
    try {
        try { [AapLinJobObject]::Assign($job, $p.Handle) } catch { throw 'AAP_ChildUncapped: the call child could not be put in its job object' }
        $in = $p.StandardInput.BaseStream
        try {
            $head = [Text.Encoding]::ASCII.GetBytes($Call.Envelope + "`n")
            $in.Write($head, 0, $head.Length)
            # The payload (a JIT config) goes to the pipe unbuffered: written through $in it would stay behind in that
            # stream's private 4 KiB write buffer, which nothing can zero. Asking for the handle flushes the envelope first.
            if ([int]$Call.PayloadLength -gt 0) { & $Call.WritePayload (New-Object IO.FileStream($in.SafeFileHandle, [IO.FileAccess]::Write, 1)) }
            $in.Flush()
        } catch {
            $null = $_   # it exited without reading; its exit code tells why
        }
        try { $p.StandardInput.Close() } catch { $null = $_ }
        $out = $p.StandardOutput.BaseStream
        $err = $p.StandardError.BaseStream
        $scratch = New-Object byte[] $script:ErrMax
        $outTask = $out.ReadAsync($buf, 0, $buf.Length)
        $errTask = $err.ReadAsync($scratch, 0, $scratch.Length)
        $stopped = $null
        while ($null -eq $stopped -and ($null -ne $outTask -or $null -ne $errTask)) {
            $left = [int][Math]::Ceiling(($deadline - [DateTime]::UtcNow).TotalMilliseconds)
            $tasks = [Threading.Tasks.Task[]]@(@($outTask, $errTask) | Where-Object { $null -ne $_ })
            if ($left -le 0 -or [Threading.Tasks.Task]::WaitAny($tasks, $left) -lt 0) { $stopped = 'timeout'; break }
            if ($null -ne $outTask -and $outTask.IsCompleted) {
                $got = $outTask.Result
                if ($got -le 0) { $outTask = $null } else {
                    $n += $got
                    if ($n -ge $buf.Length) { $stopped = 'overflow'; break }   # check:child-cap
                    $outTask = $out.ReadAsync($buf, $n, $buf.Length - $n)
                }
            }
            if ($null -ne $errTask -and $errTask.IsCompleted) {
                if ($errTask.Result -le 0) { $errTask = $null } else { $errTask = $err.ReadAsync($scratch, 0, $scratch.Length) }
            }
        }
        if ($null -eq $stopped) {
            $left = [int][Math]::Max(0, [Math]::Ceiling(($deadline - [DateTime]::UtcNow).TotalMilliseconds))
            if (-not $p.WaitForExit($left)) { $stopped = 'timeout' }
        }
        if ($null -ne $stopped) {
            [AapLinJobObject]::Kill($job)
            return @{ ExitCode = $null; Stdout = $null; TimedOut = ($stopped -ceq 'timeout'); Overflow = ($stopped -ceq 'overflow') }
        }
        $p.WaitForExit()
        $stdout = New-Object byte[] $n
        [Array]::Copy($buf, $stdout, $n)
        @{ ExitCode = $p.ExitCode; Stdout = $stdout; TimedOut = $false; Overflow = $false }
    } finally {
        [Array]::Clear($buf, 0, $buf.Length)
        if ($job -ne [IntPtr]::Zero) { [AapLinJobObject]::Close($job) }   # kill on close: nothing of the call outlives it
        try { if (-not $p.HasExited) { $p.Kill() } } catch { $null = $_ }
        $p.Dispose()
    }
}

# ---- Hyper-V reads ----------------------------------------------------------------------------------------------------

# Every VM on the host, complete or throws (a listing error never reads as an empty host).
function Get-AapLinVms($B) {
    $list = @(foreach ($v in @(& $B.Provider.ListVms @{})) {
        $id = ([string](Get-AapLinField $v 'Id')).ToLowerInvariant(); $name = [string](Get-AapLinField $v 'Name')
        if ($id -cnotmatch $script:GuidRe -or -not $name) { throw 'AAP_InventoryIncomplete: a VM entry has no name or id' }   # check:vm-entry
        [pscustomobject]@{ Id = $id; Name = $name; State = [string](Get-AapLinField $v 'State'); Cpus = Get-AapLinField $v 'Cpus'; MemGib = Get-AapLinField $v 'MemGib' }
    })
    $list
}

# The VM's settings against backend-lifecycle.md (create) and P07's clone needs: generation 2, Secure Boot with the
# Microsoft UEFI CA template, checkpoints off, TurnOff/Nothing, static memory, nested virtualization exposed (the hosted
# image offers /dev/kvm; README, Decisions), Guest Service Interface off, Key-Value Pair Exchange on (the guest publishes
# its host key there; guest-transport.md), the reserved CPU and memory, every file under the reservation's clone folder,
# exactly os.avhdx as disk, the seed as the only DVD until it is ejected and no medium after, no COM port, GPU partition
# or assigned device.
function Assert-AapLinVmConfig($B, $r, [string]$VmId, [string]$Clone, [string]$Os, [string]$Seed) {
    $c = & $B.Provider.GetVmConfig @{ VmId = $VmId }
    $bad = New-Object Collections.Generic.List[string]
    $under = { param($p, $dir) $p = [string]$p; $p -and ($p.TrimEnd('\') -ieq $dir -or $p.StartsWith($dir + '\', [StringComparison]::OrdinalIgnoreCase)) }
    if ([int](Get-AapLinField $c 'Generation') -ne 2) { $bad.Add('not generation 2') }   # check:vm-settings
    if ((Get-AapLinField $c 'SecureBoot') -ne $true -or [string](Get-AapLinField $c 'SecureBootTemplate') -cne $script:SecureBootTemplate) { $bad.Add("Secure Boot is not on with $($script:SecureBootTemplate)") }   # check:vm-settings
    if ([string](Get-AapLinField $c 'CheckpointType') -cne 'Disabled') { $bad.Add('checkpoints are not disabled') }   # check:vm-settings
    if ([string](Get-AapLinField $c 'AutomaticStopAction') -cne 'TurnOff' -or [string](Get-AapLinField $c 'AutomaticStartAction') -cne 'Nothing') { $bad.Add('automatic start or stop action') }   # check:vm-settings
    if ((Get-AapLinField $c 'DynamicMemory') -ne $false -or (Get-AapLinField $c 'NestedVirtualization') -ne $true) { $bad.Add('dynamic memory, or nested virtualization not exposed') }   # check:vm-settings
    if ((Get-AapLinField $c 'GuestServiceInterface') -ne $false) { $bad.Add('Guest Service Interface is on') }   # check:vm-integration
    if ((Get-AapLinField $c 'KeyValuePairExchange') -ne $true) { $bad.Add('Key-Value Pair Exchange is off: the host key cannot be pinned') }   # check:vm-integration
    if ([int](Get-AapLinField $c 'Cpus') -ne [int]$r.cpus -or [int](Get-AapLinField $c 'MemGib') -ne [int]$r.mem_gib) { $bad.Add('CPU or memory differs from the reservation') }   # check:vm-settings
    foreach ($k in 'ConfigurationLocation', 'SnapshotFileLocation', 'SmartPagingFilePath') {
        if (-not (& $under (Get-AapLinField $c $k) $Clone)) { $bad.Add("$k is outside the reservation's clone folder") }   # check:vm-paths
    }
    $disks = Get-AapLinField $c 'Disks'   # assigned first: the field comes back as one array object
    $disks = @($disks | Where-Object { $null -ne $_ } | ForEach-Object { [string]$_ })
    if ($disks.Count -ne 1 -or $disks[0] -ine $Os) { $bad.Add('the disks are not exactly os.avhdx') }   # check:vm-devices
    $dvds = Get-AapLinField $c 'Dvds'
    $dvds = @($dvds | Where-Object { $_ } | ForEach-Object { [string]$_ })
    $want = @($Seed | Where-Object { $_ })
    $what = $(if ($Seed) { 'the DVD is not exactly the seed' } else { 'a DVD medium is still attached' })
    if ($dvds.Count -ne $want.Count -or @($want | Where-Object { $dvds -inotcontains $_ }).Count) { $bad.Add($what) }   # check:vm-devices
    foreach ($k in 'ComPorts', 'GpuPartitions', 'AssignedDevices') {
        $v = Get-AapLinField $c $k
        if ($null -eq $v -or [int]$v -ne 0) { $bad.Add("$k attached or unknown") }   # check:vm-devices
    }
    if ($bad.Count) { throw "AAP_VmUntrusted: $($bad -join '; ')" }
}

# The P10.0 module's request for this clone, and Attach (host-network-module.md, Consumer obligations 1 and 2): the VM
# must be Off; a repeated Attach returns the same declaration from the module's own journal, so the backend keeps no copy
# of it anywhere and asks again before every start. The declaration check is the shared one (AAP_NetworkInvalid).
function Get-AapLinNetRequest($r, [string]$VmId) { @{ VmId = $VmId; VmName = (Get-AapLinVmName $r); Profile = 'linux' } }
function Connect-AapLinNetwork($B, $Net) {
    $decl = $null
    try { $decl = & $B.Network.Attach $Net } catch { throw "AAP_NetworkUntrusted: Attach failed: $(Get-AapLinError $_)" }
    $bad = @(Get-AapHostNetworkDeclarationProblems -Request $Net -Declaration $decl)
    if ($bad.Count) { throw "AAP_NetworkInvalid: $(@($bad | ForEach-Object { Get-AapLinLine ([string]$_) 100 }) -join '; ')" }   # check:network-declaration
    , $decl
}

# The guest network before a start: the module's Verify, every object it writes a problem (nothing is dropped, an empty or
# $null item included), and Hyper-V's own read-back of the VM's adapters through this backend's provider, never through
# the module, judged by the shared check against the declaration (one adapter on aap-guests-linux, Internal, its guards,
# mirroring, VLAN, storm limit, no legacy ACL, its peers, and every port ACL: the fixed denies both ways, the source pin,
# no other Allow). Anything else is AAP_NetworkUntrusted.
function Assert-AapLinNetwork($B, $Net, $Decl) {
    $problems = $null
    try { $problems = @(& $B.Network.Verify $Net) } catch { throw "AAP_NetworkUntrusted: the guest network cannot be verified: $(Get-AapLinError $_)" }
    if ($problems.Count) { throw "AAP_NetworkUntrusted: $(@($problems | ForEach-Object { Get-AapLinLine ([string]$_) 100 }) -join '; ')" }   # check:network-verify
    $nics = Get-AapLinField (& $B.Provider.GetVmConfig @{ VmId = $Net.VmId }) 'Adapters'
    $bad = @(Get-AapHostNetworkAdapterProblems -Declaration $Decl -Adapters @($nics))
    if ($bad.Count) { throw "AAP_NetworkUntrusted: $(@($bad | ForEach-Object { Get-AapLinLine ([string]$_) 100 }) -join '; ')" }   # check:network-readback
}

# A running clone's network, again (Consumer obligations 3): Verify alone (the read-back needs the declaration, and only
# Attach of an Off VM gives it), at most every StatusSeconds per reservation, so a host address change is seen within
# that time. Returns the reason to stop the clone, or $null.
function Get-AapLinRunningNetworkProblem($B, $r, [string]$VmId) {
    $rid = [string]$r.reservation_id
    $now = Get-AapLinNow $B
    if ($B.NetAt.ContainsKey($rid) -and ($now - $B.NetAt[$rid]).TotalSeconds -lt $B.StatusSeconds) { return $null }
    $B.NetAt[$rid] = $now
    $problems = $null
    try { $problems = @(& $B.Network.Verify (Get-AapLinNetRequest $r $VmId)) } catch { return 'network not verifiable' }
    if ($problems.Count) { return 'network not verified' }
    $null
}

# ---- the hard VM lifetime cap (owner decision Q4; allocator.md L1 to L8, B1 and B7) ---------------------------------------

# The cap in force: $Backend.CapHours when it is a whole number 1..6, else the 6 hour ceiling; never above it. An invalid
# value is reported once per value (a warning), never silently.
function Get-AapLinCapHours($B) {
    $h = $B.CapHours
    if (($h -is [int] -or $h -is [long]) -and $h -ge 1 -and $h -le $script:CeilingHours) { return [int]$h }   # check:cap-hours
    $seen = "$($h)|$(if ($null -ne $h) { $h.GetType().Name })"
    if ($B.CapHoursWarned -cne $seen) {
        $B.CapHoursWarned = $seen
        Write-Warning "AapLinBackend: cap_hours $(Get-AapLinLine ([string]$h) 40) is not a whole number 1..6; the 6 h ceiling is in force"
    }
    $script:CeilingHours
}

# true_now (allocator.md L7) in this process: the wall clock, or the previous estimate advanced by the boot-bound counter
# when that is later, so a clock stepped back neither stops the cap's clock nor turns it back. Across a restart the
# supervisor's lifetime-clock.json (P12.3) carries it; this backend re-decides from acquired_at and this clock.
function Get-AapLinTrueNow($B) {
    $now = Get-AapLinNow $B
    $mono = [long](& $B.Mono)
    if ($null -ne $B.High) {
        $run = $B.High.At.AddMilliseconds([double][Math]::Max([long]0, $mono - $B.High.Mono))
        if ($run -gt $now) { $now = $run }   # check:true-now
    }
    $B.High = @{ At = $now; Mono = $mono }
    $now
}

# The reservation's evidence clock (backend-lifecycle.md, Ordering timestamps): true time, never before the reservation's
# start and never behind an earlier sample of the same reservation.
function Get-AapLinEvidenceNow($B, [string]$Rid, [datetime]$Started) {
    $t = Get-AapLinTrueNow $B
    if ($t -lt $Started) { $t = $Started }
    if ($B.Evidence.ContainsKey($Rid) -and $B.Evidence[$Rid] -gt $t) { $t = $B.Evidence[$Rid] }
    $B.Evidence[$Rid] = $t
    $t
}

# The deadline record the VM carries in its own Notes (allocator.md B1, vm-cap-notes.schema.json): one compact ASCII JSON
# object; its deadline is the start plus the 6 hour ceiling, never the configured cap, so no settings change rewrites it.
function Get-AapLinNotes($r, [string]$VmId) {
    $started = ConvertTo-AapLinUtc $r.acquired_at
    $n = [ordered]@{ schema = 1; kind = 'aap-vm-cap'; vm_id = $VmId; vm_name = (Get-AapLinVmName $r); reservation_id = [string]$r.reservation_id
        started_utc = (Format-AapLinTime $started); deadline_utc = (Format-AapLinTime $started.AddHours($script:CeilingHours)); check = ''
    }
    $sha = [Security.Cryptography.SHA256]::Create()
    try { $h = $sha.ComputeHash([Text.Encoding]::ASCII.GetBytes('aap-vm-cap:1|' + (@($n.vm_id, $n.vm_name, $n.reservation_id, $n.started_utc, $n.deadline_utc) -join '|'))) }
    finally { $sha.Dispose() }
    $n.check = (($h | ForEach-Object { $_.ToString('x2') }) -join '').Substring(0, 32)
    ConvertTo-Json -InputObject $n -Compress
}

# The watchdog's clock record file: owned by an admin (or the trusted test user), nobody else may write it.
function Get-AapLinFileTrustProblem($B, [string]$Path, $Raw = $null) {
    $raw = $Raw
    if ($null -eq $raw) { try { $raw = Get-AapLinRawSd $Path } catch { return 'cannot read its ACL' } }
    if ($null -eq $raw.Owner -or $B.TrustedSids -notcontains $raw.Owner.Value) { return "owner $($raw.Owner) is not an admin" }
    if ($null -eq $raw.DiscretionaryAcl) { return 'no DACL' }
    foreach ($ace in $raw.DiscretionaryAcl) {
        $type = [int]$ace.AceType
        if ($type -ne 0 -and $type -ne 1) { return 'an ACE that is not a plain allow or deny' }   # check:backstop-file
        if ($type -ne 0 -or $B.TrustedSids -contains $ace.SecurityIdentifier.Value) { continue }
        if ((([int]$ace.AccessMask) -band $script:WriteMask) -ne 0) { return "grants $($ace.SecurityIdentifier.Value) write" }
    }
    $null
}

# The host watchdog's clock record (allocator.md B7): $null when it lets a VM start, else '<sub-reason>[: text]' with
# sub-reason unconfigured, boot_id_unreadable, untrusted, missing, invalid, other_boot, stale or breach.
function Get-AapLinBackstopProblem($B) {
    $p = [string]$B.WatchdogClockPath
    if (-not $p) { return 'unconfigured: no watchdog clock record path' }
    if ($p -notmatch '^[A-Za-z]:\\.+[^\\]\z' -or [IO.Path]::GetFullPath($p) -cne $p) { return 'unconfigured: the watchdog clock record path is not absolute and normalized' }
    try { $boot = [string](& $B.Provider.GetBootId @{}) } catch { return "boot_id_unreadable: $(Get-AapLinError $_)" }
    if ($boot -cnotmatch '^[0-9a-f-]{8,64}\z') { return 'boot_id_unreadable: not a boot id' }
    $why = @(Get-AapLinTrustProblem $B (Split-Path -Parent $p))
    if ($why.Count) { return "untrusted: $(Get-AapLinLine ($why -join '; ') 160)" }   # check:backstop-trust
    $kind = Get-AapLinPathKind $p
    if ($kind -ceq 'absent') { return 'missing: no watchdog clock record' }
    if ($kind -cne 'file') { return "untrusted: the watchdog clock record is a $kind" }
    $why = Get-AapLinFileTrustProblem $B $p
    if ($why) { return "untrusted: $why" }   # check:backstop-trust
    try {
        $fs = New-Object IO.FileStream($p, [IO.FileMode]::Open, [IO.FileAccess]::Read, [IO.FileShare]::Read)
        try {
            $buf = New-Object byte[] ($script:WatchdogMax + 1)
            $n = 0
            while ($n -lt $buf.Length) { $k = $fs.Read($buf, $n, $buf.Length - $n); if ($k -le 0) { break }; $n += $k }
        } finally { $fs.Dispose() }
        if ($n -gt $script:WatchdogMax) { return 'invalid: the watchdog clock record is larger than 64 KiB' }
        $doc = ConvertFrom-AapLinJson ((New-Object Text.UTF8Encoding($false, $true)).GetString($buf, 0, $n))
    } catch { return "invalid: $(Get-AapLinError $_)" }
    if (-not ($doc -is [Management.Automation.PSCustomObject])) { return 'invalid: not one JSON object' }
    if ((Get-AapLinField $doc 'schema') -isnot [long] -and (Get-AapLinField $doc 'schema') -isnot [int]) { return 'invalid: schema' }
    if ((Get-AapLinField $doc 'schema') -ne 1 -or [string](Get-AapLinField $doc 'role') -cne 'watchdog') { return 'invalid: not a watchdog clock record of schema 1' }
    $latched = Get-AapLinField $doc 'latched'
    if (-not ($latched -is [array])) { return 'invalid: latched is not a list' }   # check:backstop-latched
    foreach ($l in $latched) { if (-not ($l -is [Management.Automation.PSCustomObject])) { return 'invalid: latched holds something that is not an object' } }   # check:backstop-latched
    if ([string](Get-AapLinField $doc 'boot_id') -cne $boot) { return 'other_boot: the watchdog clock record is of another host boot' }   # check:backstop-boot
    try { $written = ConvertTo-AapLinUtc (Get-AapLinField $doc 'written_utc') } catch { return 'invalid: written_utc' }
    $age = ((Get-AapLinNow $B) - $written).TotalSeconds
    if ($age -gt $script:WatchdogFreshSeconds -or $age -lt -$script:WatchdogAheadSeconds) { return "stale: written $([int]$age) s ago" }   # check:backstop-fresh
    foreach ($l in $latched) { if ([string](Get-AapLinField $l 'enforcement_stage') -ceq $script:CapBreach) { return 'breach: the watchdog reports an unresolved cap breach' } }   # check:backstop-breach
    $null
}

# The start gate (backend-lifecycle.md, Deadline record and start gate; allocator.md B1, B7 and L6 b): a VM starts only
# while its Notes read back as the record this reservation gives, its deadline is still ahead by true time, this backend
# holds no unresolved cap breach, and the host watchdog's clock record lets it. Returns @{ Code; Detail }, or $null.
function Get-AapLinStartProblem($B, $r, [string]$VmId) {
    try {
        $notes = Get-AapLinNotes $r $VmId
        if ([string](& $B.Provider.GetVmNotes @{ VmId = $VmId }) -cne $notes) { return @{ Code = 'notes_unverified'; Detail = 'the VM Notes do not read back as its deadline record' } }   # check:start-notes
        $deadline = (ConvertTo-AapLinUtc $r.acquired_at).AddHours($script:CeilingHours)
        if ((Get-AapLinEvidenceNow $B ([string]$r.reservation_id) (ConvertTo-AapLinUtc $r.acquired_at)) -ge $deadline) { return @{ Code = 'deadline_passed'; Detail = 'the 6 h deadline has passed' } }   # check:start-deadline
    } catch { return @{ Code = 'notes_unverified'; Detail = (Get-AapLinError $_) } }
    $held = @($B.Capped.Keys | Where-Object { $B.Capped[$_].Running })
    if ($held.Count) { return @{ Code = 'backstop_down'; Detail = "local_cap_breach: $($held -join ', ') not observed off" } }   # check:start-local-breach
    $why = Get-AapLinBackstopProblem $B
    if ($why) { return @{ Code = 'backstop_down'; Detail = $why } }
    $null
}

# One latch (allocator.md L4 step 1): every field present, so strict mode never meets a missing one.
function New-AapLinCapLatch([string]$Trigger, $Elapsed, [int]$Hours) {
    @{ Trigger = $Trigger; Elapsed = $Elapsed; Hours = $Hours; PowerOff = $null; Started = $null; Decided = $null; VmId = ''; Running = $false
        Unavailable = $false; StopError = $null; Error = $null; Torn = $false
    }
}

# The VMs of a reservation: by its id; by the name derived from the reservation only while no id is known or no VM has
# that id.
function Get-AapLinOwnVms($B, $r, [string]$VmId) {
    $all = @(Get-AapLinVms $B)
    if ($VmId) {
        $byId = @($all | Where-Object { $_.Id -ceq $VmId })
        if ($byId.Count) { return $byId }
    }
    $name = Get-AapLinVmName $r
    @($all | Where-Object { $_.Name -ceq $name })
}

# Powers off every VM of the reservation that is not observed Off, at the hypervisor, never through the guest.
# power_off_utc is captured at issuance (backend-lifecycle.md, Ordering timestamps), whether the call then returns or
# throws; it stays $null only while no power-off was ever issued. Errors of this pass are kept (a later success on
# another VM clears none) until the VM is observed Off. Then observes: Running, Unavailable (the list itself failed).
function Invoke-AapLinCapStop($B, $r, $cap) {
    $cap.Running = $true
    $cap.Unavailable = $false
    $errors = New-Object Collections.Generic.List[string]
    try {
        foreach ($vm in @(Get-AapLinOwnVms $B $r ([string]$cap.VmId))) {
            if (-not $cap.VmId) { $cap.VmId = [string]$vm.Id }
            if ($vm.State -ceq 'Off') { continue }
            if ($null -eq $cap.PowerOff -and $null -ne $cap.Started) {   # check:poweroff-issued
                try { $cap.PowerOff = Get-AapLinEvidenceNow $B ([string]$r.reservation_id) $cap.Started } catch { $errors.Add("clock: $(Get-AapLinError $_)") }
            }
            try { & $B.Provider.StopVm @{ VmId = $vm.Id } } catch { $errors.Add("Stop-VM failed: $(Get-AapLinError $_)") }
        }
        $cap.Running = @(Get-AapLinOwnVms $B $r ([string]$cap.VmId) | Where-Object { $_.State -cne 'Off' }).Count -gt 0
    } catch { $cap.Unavailable = $true; $errors.Add("VM list failed: $(Get-AapLinError $_)") }   # an inventory or observation that failed proves nothing
    if ($cap.Running -or $cap.Unavailable) { if ($errors.Count) { $cap.StopError = $errors -join '; ' } }
    else { $cap.StopError = $null }   # observed Off: the power-off took, whatever a call said
}
# The decision of allocator.md L2 and L7 for one reservation. Due when its age by true time reaches the cap in force
# (exactly the cap counts); when the age is negative (the clock behind the start: a clock problem, capped as
# clock_unavailable with no measured age); when this process latched it before (no later clock reading un-caps it); when
# its journal carries the evidence already (a restart decides again); or, with -ClockSafety, when its VM exists at this
# process's first look (L7: time across a host reboot or a lost clock record cannot be recovered; a VM found off is capped
# too, so recovery never starts it). Only acquired_at, the cap and the host clocks decide: no guest reply, heartbeat, job
# state, broker answer or runner status enters. Returns the latch or $null; throws only what the caller turns into
# enforcement_unavailable.
function Get-AapLinCapDecision($B, $r, $j, [datetime]$Started) {
    $rid = [string]$r.reservation_id
    $prior = $null
    if ($B.Capped.ContainsKey($rid)) { $prior = $B.Capped[$rid]; if (-not $prior.Error) { return $prior } }
    $hours = Get-AapLinCapHours $B
    # The age from true time itself, never floored; the evidence clock's floor at the start orders timestamps only.
    $age = [long][Math]::Floor(((Get-AapLinTrueNow $B) - $Started).TotalSeconds)
    $now = Get-AapLinEvidenceNow $B $rid $Started
    $cap = $null
    if ($age -ge [long]$hours * 3600) { $cap = (New-AapLinCapLatch 'deadline' $age $hours) }   # check:cap-deadline
    if ($null -eq $cap -and $age -lt 0) { $cap = (New-AapLinCapLatch 'clock_unavailable' $null $hours) }   # check:cap-negative
    if ($null -eq $cap -and $null -ne $j -and $null -ne $j.Cap) {   # check:cap-journal
        $c = $j.Cap
        $cap = New-AapLinCapLatch ([string](Get-AapLinField $c 'trigger')) (Get-AapLinField $c 'elapsed_s') ([int](Get-AapLinField $c 'cap_hours'))
        $cap.PowerOff = ConvertTo-AapLinUtc (Get-AapLinField $c 'power_off_utc')
    }
    if ($null -eq $cap -and $B.ClockSafety -and -not $B.CapSeen.ContainsKey($rid)) {
        $vmId = [string](Get-AapLinField $r 'vm_id')
        if (-not $vmId -and $null -ne $j) { $vmId = [string]$j.VmId }
        $on = @(Get-AapLinOwnVms $B $r $vmId)   # a failed list throws: the first look is retried, never taken for no VM
        $measured = $null
        if ($age -ge 0) { $measured = $age }
        if ($on.Count) { $cap = (New-AapLinCapLatch $B.ClockSafety $measured $hours) }   # check:cap-safety
    }
    $B.CapSeen[$rid] = $true
    if ($null -eq $cap -and $null -ne $prior) {
        # Latched after a failed decision: it stays capped (the VM was powered off), now with what can be measured.
        $measured = $null
        if ($age -ge 0) { $measured = $age }
        $cap = (New-AapLinCapLatch 'clock_unavailable' $measured $hours)
    }
    if ($null -ne $cap) { $cap.Decided = $now }
    $cap
}

# Steps 1 and 2 of allocator.md L4: decide, latch in memory, power off, observe. A decision that throws (an unreadable
# start time, a clock that fails, a journal whose evidence does not parse) never fails open: the VM is powered off by its
# id or derived name and the latch carries the error (enforcement_unavailable) until a later decision succeeds.
function Invoke-AapLinCapPowerOff($B, $r, $j) {
    $rid = [string]$r.reservation_id
    if ([string]$r.state -ceq 'reconciled' -or ([string]$r.state -ceq 'quarantined' -and [string](Get-AapLinField $r 'quarantine_kind') -ceq 'unknown_vm')) { return $null }
    $vmId = [string](Get-AapLinField $r 'vm_id')
    if (-not $vmId -and $null -ne $j) { $vmId = [string]$j.VmId }
    $cap = $null
    try {
        $started = ConvertTo-AapLinUtc $r.acquired_at
        $cap = Get-AapLinCapDecision $B $r $j $started
        if ($null -eq $cap) { return $null }
        $cap.Started = $started
        $cap.Error = $null
    } catch {
        $err = Get-AapLinError $_
        $cap = $(if ($B.Capped.ContainsKey($rid)) { $B.Capped[$rid] } else { (New-AapLinCapLatch 'clock_unavailable' $null $script:CeilingHours) })
        $cap.Error = "decision failed: $err"
    }
    $B.Capped[$rid] = $cap   # the latch: capped for the life of this process
    if (-not $cap.VmId) { $cap.VmId = $vmId }
    Invoke-AapLinCapStop $B $r $cap
    if ($null -eq $cap.PowerOff -and -not $cap.Running -and $null -ne $cap.Started) { $cap.PowerOff = $cap.Decided }   # nothing was running: the decision is the power-off
    $cap
}

# The lifetime_cap evidence of the destroy intent (backend-lifecycle.schema.json), or $null while it cannot be formed (no
# known start, no power-off that returned): power_off_utc and the record's at come from the reservation's evidence clock.
function Get-AapLinCapEvidence($cap) {
    if ($null -eq $cap.Started -or $null -eq $cap.PowerOff) { return $null }
    [ordered]@{ cap_hours = [int]$cap.Hours; started_utc = (Format-AapLinTime $cap.Started); deadline_utc = (Format-AapLinTime $cap.Started.AddHours([int]$cap.Hours))
        elapsed_s = $cap.Elapsed; trigger = $cap.Trigger; power_off_utc = (Format-AapLinTime $cap.PowerOff); reason = 'vm_lifetime_cap'
    }
}

function New-AapLinCapResult($r, [string]$Action, [string]$Code, $Evidence, [string[]]$Details) {
    $out = New-AapLinResult $r $Action $Code
    $out.LifetimeCap = $Evidence
    $d = @($Details | Where-Object { $_ })
    if ($d.Count) { $out.Detail = Get-AapLinLine ($d -join '; ') 400 }
    $out
}

# The cap for one reservation, first on every step (allocator.md L3, L4): after the power-off, persist (the allocator down
# to deleting; a failed vm_lifetime_cap record for every open op but destroy; the destroy intent with the evidence as soon
# as it can be formed, held or not, once per reservation), then the ordinary verified teardown, the slot freed only by its proof (L6).
# A VM not observed Off is an unresolved cap_breach (L5), a failed list or decision enforcement_unavailable: the slot
# stays held, only the power-off is repeated, and no guest call follows the decision in any case. Every failure on the
# way (the power-off, the allocator, the journal) is carried in Detail, never swallowed. Returns the step's result, or
# $null when not due.
function Invoke-AapLinLifetimeCap($B, $r, $j) {
    $cap = Invoke-AapLinCapPowerOff $B $r $j
    if ($null -eq $cap) { return $null }
    $vmId = [string]$cap.VmId
    $evidence = Get-AapLinCapEvidence $cap
    $notes = New-Object Collections.Generic.List[string]
    if ($cap.Error) { $notes.Add($cap.Error) }
    if ($cap.StopError) { $notes.Add($cap.StopError) }
    $hold = $(if ($cap.Unavailable -or $cap.Error) { 'enforcement_unavailable' } elseif ($cap.Running) { $script:CapBreach } else { $null })
    $s = [string]$r.state
    if (@('ready', 'busy', 'draining', 'collecting') -ccontains $s -or ($s -ceq 'creating' -and $vmId)) {
        try {
            $next = Move-AapLinState $B $r 'deleting' $vmId
            if ($null -ne $next) { $r = $next } else { $notes.Add('allocator: the move to deleting was refused; retried next step') }
        } catch { $notes.Add("allocator: $(Get-AapLinError $_)") }
    }
    if ($null -eq $j) { return (New-AapLinCapResult $r 'held' $(if ($hold) { $hold } else { 'journal_unreadable' }) $evidence $notes.ToArray()) }
    try {
        if ($null -eq $j.Cap) {   # check:cap-once
            $at = $(if ($null -ne $cap.Started) { Get-AapLinEvidenceNow $B ([string]$r.reservation_id) $cap.Started } else { Get-AapLinNow $B })
            foreach ($op in @($j.Open.Keys | Where-Object { $j.Open[$_] -and $_ -cne 'destroy' } | Sort-Object)) {
                Write-AapLinJournal $B $r $op 'failed' -VmId $vmId -Code 'vm_lifetime_cap' -Detail $script:CapDetail -At $at
            }
            if ($null -ne $evidence -and $vmId) { Write-AapLinJournal $B $r 'destroy' 'intent' -VmId $vmId -At $at -LifetimeCap $evidence }
            elseif (-not $vmId -and -not $j.Has['create/failed']) { Write-AapLinJournal $B $r 'create' 'failed' -Code 'vm_lifetime_cap' -Detail $script:CapDetail -At $at }
        }
        $j = Read-AapLinJournal $B $r
    } catch {
        $notes.Add("journal: $(Get-AapLinError $_)")
        return (New-AapLinCapResult $r 'held' $(if ($hold) { $hold } else { 'journal_unwritable' }) $evidence $notes.ToArray())   # retried every step
    }
    if ($hold) {   # check:cap-breach
        if ($vmId) {
            # The journal detail is the fixed code (backend-lifecycle.md); the error text is in the result's Detail.
            try { Write-AapLinFailedOnce $B $r $j 'destroy' $vmId 'retryable' $hold } catch { $notes.Add("journal: $(Get-AapLinError $_)") }
        }
        return (New-AapLinCapResult $r 'held' $hold $evidence $notes.ToArray())
    }
    $force = -not $cap.Torn
    $cap.Torn = $true
    $out = Invoke-AapLinDestroy $B $r $j -Force:$force -Urgent
    if (-not $out.Code) { $out.Code = 'vm_lifetime_cap' }
    $out.LifetimeCap = $evidence
    if ($notes.Count) { $out.Detail = Get-AapLinLine ($notes -join '; ') 400 }
    $out
}

# The last resort when the cap itself threw: latch, power the reservation's VM off by its id or derived name, report
# enforcement_unavailable with the error. Never fails open and never throws.
function Invoke-AapLinCapEmergency($B, $r, $j, [string]$Err) {
    $rid = [string]$r.reservation_id
    $cap = $(if ($B.Capped.ContainsKey($rid)) { $B.Capped[$rid] } else { (New-AapLinCapLatch 'clock_unavailable' $null $script:CeilingHours) })
    $cap.Error = "cap failed: $Err"
    $B.Capped[$rid] = $cap
    try {
        if (-not $cap.VmId) { $cap.VmId = [string](Get-AapLinField $r 'vm_id') }
        if (-not $cap.VmId -and $null -ne $j) { $cap.VmId = [string]$j.VmId }
        Invoke-AapLinCapStop $B $r $cap
    } catch { $cap.StopError = "power-off failed: $(Get-AapLinError $_)" }
    New-AapLinCapResult $r 'held' 'enforcement_unavailable' $null @($cap.Error, $cap.StopError)
}

# ---- lifecycle ops ------------------------------------------------------------------------------------------------------

function New-AapLinResult($r, [string]$Action, $Code = $null, $Summary = $null) {
    [pscustomobject][ordered]@{ ReservationId = [string](Get-AapLinField $r 'reservation_id'); LeaseGeneration = [long](Get-AapLinField $r 'lease_generation'); Action = $Action
        State = [string](Get-AapLinField $r 'state'); Code = $Code; Summary = $Summary
        LifetimeCap = $null; Detail = $null
    }
}

# create (backend-lifecycle.md): idempotent. Re-run after a crash it reuses only the VM whose id the journal recorded
# right after New-VM (a VM found only by its name is never adopted: create fails and destroy removes it), keeps the
# differencing disk it made (a reused os.avhdx must still be a child of the pinned base), and makes a fresh key pair and a
# fresh seed, which is safe only because the clone never booted (boot follows create's done record). Order
# (host-network-module.md, Consumer obligations 1): the VM with no adapter, Attach and the declaration check, the seed with
# the declaration's static addressing into the VM's DVD drive, the VM's settings, Verify and the read-back, then done. The
# declaration is never journaled or kept: a re-run attaches again and gets the same one.
function Invoke-AapLinCreate($B, $r, [string]$BaseSha256, $j) {
    $rid = [string]$r.reservation_id
    $name = Get-AapLinVmName $r
    $gen = [string]$r.image_generation
    if ($gen -cnotmatch $script:GenerationRe) { throw "AAP_BadGeneration: not an Ubuntu generation id: $gen" }
    if ($BaseSha256 -cnotmatch '^[0-9a-f]{64}\z') { throw 'AAP_BaseUnpinned: create needs the base SHA-256 pinned outside the roots' }   # check:base-pin
    if ([long]$r.scratch_gib -ne 0) { throw 'AAP_BadRequest: the Linux profile has no scratch disk (scratch_gib 0)' }   # check:no-scratch
    $disks = @([ordered]@{ role = 'base_ref'; path = "$gen/base.vhdx"; sha256 = $BaseSha256 }, [ordered]@{ role = 'os_diff'; path = "$rid/os.avhdx"; sha256 = $null },
        [ordered]@{ role = 'seed'; path = "$rid/seed.iso"; sha256 = $null })
    Write-AapLinJournal $B $r 'create' 'intent' -Disks $disks
    Invoke-AapLinFault 'create:after-intent'
    $problems = @(Get-AapLinStorageProblem -Backend $B)
    if ($problems.Count) { throw "AAP_StorageUntrusted: $($problems -join '; ')" }   # check:root-trust
    $problems = @(Get-AapLinHostProblem -Backend $B)
    if ($problems.Count) { throw ($problems -join '; ') }   # check:host-trust
    $baseRoot = $B.Storage.base_root.Path
    $base = Join-Path $baseRoot (($gen -replace '/', '\') + '\base.vhdx')
    $genDir = Split-Path -Parent $base
    Assert-AapLinPlainPath -Root $baseRoot -Path $genDir -Reason 'AAP_BaseUntrusted'
    if ((Get-AapLinPathKind $base) -cne 'file') { throw "AAP_BaseMissing: not a plain file: $base" }   # check:base-kind
    foreach ($p in @($genDir, $base)) {
        $why = Get-AapLinSealedProblem $B $p
        if ($why) { throw "AAP_BaseUntrusted: $why" }   # check:base-sealed
    }
    $clone = Get-AapLinCloneDir $B $r
    $os = Join-Path $clone 'os.avhdx'
    # One read handle that shares only reading, from the hash to the differencing disk: nobody can write, rename or delete
    # the base in between. ponytail: Hyper-V opening the parent next to this handle is a P02.1 lab check.
    $hold = New-Object IO.FileStream($base, [IO.FileMode]::Open, [IO.FileAccess]::Read, [IO.FileShare]::Read)
    try {
        if ([string](& $B.Provider.HashFile @{ Path = $base; Stream = $hold }) -cne $BaseSha256) { throw "AAP_BaseHashMismatch: does not match its pinned hash: $gen" }   # check:base-hash
        Assert-AapLinPlainPath -Root $B.Storage.clone_root.Path -Path $clone -Reason 'AAP_UnsafePath' -Create
        Invoke-AapLinFault 'create:after-folders'
        $kind = Get-AapLinPathKind $os
        if ($kind -cne 'absent' -and $kind -cne 'file') { throw "AAP_UnsafePath: os.avhdx is a ${kind}: $os" }   # check:disk-kind
        if ($kind -ceq 'absent') { & $B.Provider.NewDiffDisk @{ Path = $os; Parent = $base } }
        if ([string](& $B.Provider.GetVhdParent @{ Path = $os }) -ine $base) { throw "AAP_UnsafePath: os.avhdx is not a child of its generation's base: $os" }   # check:disk-parent
    } finally { $hold.Dispose() }
    Invoke-AapLinFault 'create:after-disks'
    $named = @(Get-AapLinVms $B | Where-Object { $_.Name -ceq $name })
    $id = [string]$j.VmId
    if ($id) {
        if ($named.Count -ne 1 -or $named[0].Id -cne $id) { throw "AAP_VmMismatch: the VM the journal recorded is not the one VM named $name" }   # check:vm-journaled
        if ($j.Has['boot/intent'] -or $named[0].State -cne 'Off') { throw 'AAP_VmMismatch: create may rewrite only a never-booted clone' }   # check:seed-never-booted
    } elseif ($named.Count) {
        throw "AAP_VmNotJournaled: a VM named $name exists that this journal never recorded; it is destroyed, never adopted"   # a crash between New-VM and its record
    }
    # The per-clone credential, fresh on every run of create: the private key straight from ssh-keygen into a folder with
    # a protected SYSTEM/Administrators DACL from its creation; only the public half comes back.
    $dir = Get-AapLinSshDir $B $r
    if ($B.Guests.ContainsKey($rid)) { [void]$B.Guests.Remove($rid) }
    Remove-AapLinTree $dir $clone
    New-AapLinDir $dir (New-AapLinSecurity $true)
    Assert-AapLinPlainPath -Root $B.Storage.clone_root.Path -Path $dir -Reason 'AAP_UnsafePath'
    $public = [string](& $B.Provider.NewKeyPair @{ Dir = $dir })
    if ($public -cnotmatch $script:Ed25519Re) { throw 'AAP_KeyInvalid: ssh-keygen gave no ed25519 public key' }   # check:key-shape
    if ((Get-AapLinPathKind (Join-Path $dir 'id_ed25519')) -cne 'file') { throw 'AAP_KeyInvalid: no private key file' }
    Write-AapLinFile (Join-Path $dir 'seq') ([Text.Encoding]::ASCII.GetBytes('0'))   # the channel's seq mark: nothing sent yet
    Invoke-AapLinFault 'create:after-key'
    if (-not $id) {
        # No network adapter and an empty DVD drive: the seed carries the declaration's addressing, so it can only be
        # made after Attach, which needs the VM.
        $id = ([string](Get-AapLinField (& $B.Provider.NewVm @{ Name = $name; Path = $clone; Cpus = [int]$r.cpus; MemGib = [int]$r.mem_gib; OsDisk = $os }) 'Id')).ToLowerInvariant()
        if ($id -cnotmatch $script:GuidRe) { throw 'AAP_Unexpected: the new VM has no id' }
        Invoke-AapLinFault 'create:after-newvm'
        # The VM's id, before anything else touches it: the only VM a re-run may reuse.
        Write-AapLinJournal $B $r 'create' 'intent' -VmId $id -Disks $disks
    }
    # The deadline record in the VM's own Notes (allocator.md B1), before the VM is ever started, and read back.
    $notes = Get-AapLinNotes $r $id
    & $B.Provider.SetVmNotes @{ VmId = $id; Notes = $notes }
    if ([string](& $B.Provider.GetVmNotes @{ VmId = $id }) -cne $notes) { throw 'AAP_NotesInvalid: the VM''s Notes do not read back as its deadline record' }   # check:create-notes
    Write-AapLinSshConfig $dir $id
    $B.Guests[$rid] = @{ VmId = $id; Dir = $dir; Seq = [long]0; Ceiling = [long]0; Started = $false; Hostile = $null }
    Invoke-AapLinFault 'create:after-vm'
    # Attach while the VM is Off (a re-run attaches again and gets the same declaration), then the seed from it.
    $net = Get-AapLinNetRequest $r $id
    $decl = Connect-AapLinNetwork $B $net
    Invoke-AapLinFault 'create:after-attach'
    $seed = Join-Path $clone 'seed.iso'
    $kind = Get-AapLinPathKind $seed
    if ($kind -cne 'absent' -and $kind -cne 'file') { throw 'AAP_SeedInvalid: the seed path is not a plain file' }
    $tmpSeed = $seed + '.tmp'
    # An interrupted writer leaves only unpublished material. Remove it without following links, then rebuild whole.
    foreach ($p in @($tmpSeed, ($tmpSeed + '.files'), ($seed + '.files'))) { Remove-AapLinTree $p $clone }
    $files = New-AapLinSeed -VmName $name -InstanceId ('aap-' + $rid.Substring(2) + '-' + [long]$r.lease_generation + '-' + (New-AapLinHex 4)) -PublicKey $public -Network $decl -ReservationId $rid -LeaseGeneration $r.lease_generation
    $made = & $B.Provider.NewSeedImage @{ Path = $tmpSeed; Label = 'CIDATA'; Files = $files }
    if ((Get-AapLinPathKind $tmpSeed) -cne 'file') { throw 'AAP_SeedInvalid: no seed image was written' }
    # Verify the complete unpublished ISO through a read-only handle before replacing the old seed atomically.
    $hold = New-Object IO.FileStream($tmpSeed, [IO.FileMode]::Open, [IO.FileAccess]::Read, [IO.FileShare]::Read)
    try {
        $size = [long](Get-AapLinField $made 'Bytes')
        if ($size -le 0 -or $hold.Length -ne $size -or [string](& $B.Provider.HashFile @{ Path = $tmpSeed; Stream = $hold }) -cne [string](Get-AapLinField $made 'Sha256')) {   # check:seed-written
            throw 'AAP_SeedInvalid: the seed image on disk is not the image that was written'
        }
    } finally { $hold.Dispose() }
    Invoke-AapLinFault 'create:before-seed-publish'
    if ($kind -ceq 'file') { [IO.File]::Replace($tmpSeed, $seed, [NullString]::Value) } else { [IO.File]::Move($tmpSeed, $seed) }   # check:seed-atomic
    Invoke-AapLinFault 'create:after-seed'
    & $B.Provider.SetSeed @{ VmId = $id; Seed = $seed }   # the one DVD drive; setting the same path again is idempotent
    Assert-AapLinVmConfig $B $r $id $clone $os $seed
    Assert-AapLinNetwork $B $net $decl
    Write-AapLinJournal $B $r 'create' 'done' -VmId $id -Disks $disks -Code 'ok' -Detail 'differencing disk, key pair, VM, network and seed created; network verified'
    Invoke-AapLinFault 'create:after-done'
    $id
}

# The runner part of the teardown proof (broker INTEGRATION.md, rules for the callers): never_registered when no lease
# was ever asked for, $true or 'github-removed' when the release closed the lease, 'pending' to ask again later and
# 'uncertain' when the broker lost a lease it had issued (never proof).
function Get-AapLinRunnerProof($B, $r, $j, [bool]$Recheck = $true) {
    if (-not $j.Has['run_one/intent']) { return 'never_registered' }
    if (-not $j.LeaseId) { return 'uncertain' }
    $ba = $B.BrokerArgs
    if ($Recheck -and $j.DrainedOnline) {
        # The drain saw the runner idle one sample ago; a job may have started since. Released only on the broker's word
        # that it is still idle: busy, unavailable, timed out or an unreadable reply keep the runner and its VM (pending).
        # An urgent teardown (a broken limit, a hostile guest) does not ask: its VM goes anyway.
        $bs = Invoke-AapBrokerStatus -LeaseId $j.LeaseId @ba
        if ($bs.Outcome -cne 'ok' -or $bs.RunnerBusy -ne $false) { return 'pending' }   # check:release-busy
    }
    $rel = Invoke-AapBrokerRelease -LeaseId $j.LeaseId @ba
    if ($rel.Outcome -ceq 'deregistered') { return $true }
    if ($rel.Outcome -ceq 'already_gone') { return 'github-removed' }
    if ($rel.Outcome -ceq 'refused' -and $rel.Reason -ceq 'not_found') {
        $known = [string]$B.Leases[[string]$r.reservation_id]
        if ($j.LeaseIssued -or @('issued', 'bad_reply') -ccontains $known) { return 'uncertain' }   # check:release-uncertain
        # A lease call the broker never recorded can no longer reach it (each broker run ends within 55 s).
        if ($null -ne $j.RunOneAt -and ((Get-AapLinNow $B) - $j.RunOneAt).TotalMinutes -ge $script:LeaseWindowMinutes) { return 'never_registered' }   # check:lease-window
    }
    'pending'
}

# True only when the VM (by id and by name) and both reservation folders are observed absent (the clone folder holds the
# disk, the seed, every VM file and the per-clone key), on both tier roots present and on the volumes the storage document
# records: a root that is missing or on another volume (a USB disk not back yet) would make every folder look gone.
function Test-AapLinGone($B, [string]$VmId, [string]$Name, [string]$Clone, [string]$Scratch) {
    try {
        foreach ($t in 'clone_root', 'scratch_root') {
            $root = $B.Storage[$t]
            if ((Get-AapLinPathKind $root.Path) -cne 'dir' -or [string](& $B.Provider.GetVolumeGuid @{ Path = $root.Path }) -cne $root.Guid) { return $false }   # check:gone-volume
        }
        $vms = @(Get-AapLinVms $B | Where-Object { ($VmId -and $_.Id -ceq $VmId) -or $_.Name -ceq $Name })
        if ($vms.Count) { return $false }   # check:observe-absent
        if ((Get-AapLinPathKind $Clone) -cne 'absent') { return $false }   # check:observe-absent
        if ((Get-AapLinPathKind $Scratch) -cne 'absent') { return $false }   # check:observe-scratch
    } catch { return $false }
    $true
}

# destroy (backend-lifecycle.md): release the lease if one was ever asked for, turn the VM off and remove it, detach it
# from the guest network, delete both reservation folders (the clone folder with the key, the seed and every VM file)
# through reparse-checked paths, then observe absence. Only observed absence plus a final runner proof completes the
# teardown (Complete-AapTeardown frees the slot). The VM goes whatever the release answered, except after a drain: a
# runner that was listening may still be listed, so its VM stays until the release is final. -Urgent (a hostile guest, a
# broken limit, a failed op) removes the VM in every case. A VM or folder that will not go after three tries quarantines
# the slot (teardown_failed, capacity held); an uncertain runner does the same; a pending release keeps it deleting. A
# retry continues the journaled intent and repeats no identical failure record; it runs at most once a minute (-Force:
# now). A VM kept here (a drain waiting for its release, a teardown being retried) still runs whatever GitHub hands its
# runner, so the host-side limits hold on every step, before the retry gate. A breach makes the destroy urgent, at once
# the first time this process sees it. Time ends a kept VM only through the lifetime cap (Invoke-AapLinLifetimeCap), which
# powers it off before this runs.
function Invoke-AapLinDestroy($B, $r, $j, [switch]$Force, [switch]$Urgent) {
    $rid = [string]$r.reservation_id
    $name = Get-AapLinVmName $r
    $now = Get-AapLinNow $B
    $breach = $null
    if (-not $Urgent) {
        $breach = Get-AapLinLimitBreach $B $r $j
        if ($breach) {   # check:deleting-limits
            $Urgent = $true
            if (-not $B.Breached.ContainsKey($rid)) { $B.Breached[$rid] = $true; $Force = $true } else { $breach = $null }
        }
    }
    $last = $j.LastDestroyFail
    if ($B.Tried.ContainsKey($rid) -and ($null -eq $last -or $B.Tried[$rid] -gt $last)) { $last = $B.Tried[$rid] }
    if (-not $Force -and $null -ne $last -and ($now - $last).TotalSeconds -lt $script:RetrySeconds) { return (New-AapLinResult $r 'waiting' 'retry_later') }
    $B.Tried[$rid] = $now
    $clone = Get-AapLinCloneDir $B $r
    $scratch = Join-Path $B.Storage.scratch_root.Path $rid
    $vmId = [string](Get-AapLinField $r 'vm_id')
    if (-not $vmId) { $vmId = [string]$j.VmId }
    $mine = @(Get-AapLinVms $B | Where-Object { ($vmId -and $_.Id -ceq $vmId) -or $_.Name -ceq $name })
    if (-not $vmId -and $mine.Count) { $vmId = $mine[0].Id }
    if (-not $vmId) {
        # No VM ever existed for this reservation, so no lease either: remove the folders, free it as never registered.
        Write-AapLinFailedOnce $B $r $j 'create' '' 'fatal' 'abandoned before a VM existed; reservation folders removed'
        foreach ($d in @(@($clone, $B.Storage.clone_root.Path), @($scratch, $B.Storage.scratch_root.Path))) { try { Remove-AapLinTree $d[0] $d[1] } catch { $null = $_ } }
        [void]$B.Guests.Remove($rid)
        if (-not (Test-AapLinGone $B '' $name $clone $scratch)) { return (New-AapLinResult $r 'held' 'folders_remain') }
        $proof = [ordered]@{ kind = 'vm'; observed_at = (Format-AapLinTime $now); vm_absent = $true; disks_absent = $true; vm_files_absent = $true; runner_deregistered = 'never_registered' }
        $a = Get-AapLinAllocArgs $B $r
        $c = Complete-AapTeardown @a -Proof $proof
        if ($c.Ok) { $next = Get-AapLinField $c 'Reservation'; if ($null -ne $next) { $r = $next }; return (New-AapLinResult $r 'destroyed') }
        return (New-AapLinResult $r 'held' $c.Reason)
    }
    if ($j.Last -notlike 'destroy/*') { Write-AapLinJournal $B $r 'destroy' 'intent' -VmId $vmId }   # check:destroy-once
    if ($breach) { Write-AapLinJournal $B $r 'destroy' 'failed' -VmId $vmId -Code 'fatal' -Detail "limit broken while kept: $breach" }
    Invoke-AapLinFault 'destroy:after-intent'
    $runner = Get-AapLinRunnerProof $B $r $j (-not $Urgent)
    Invoke-AapLinFault 'destroy:after-release'
    if (-not $Urgent -and $runner -is [string] -and $runner -ceq 'pending' -and $j.DrainedOnline) {   # check:drain-keep
        Write-AapLinFailedOnce $B $r $j 'destroy' $vmId 'retryable' 'runner release pending; the drained VM stays until it is final'
        return (New-AapLinResult $r 'waiting' 'release_pending')
    }
    $gone = $false
    for ($try = 1; $try -le $script:TeardownTries; $try++) {
        $detached = $false
        try {
            foreach ($vm in @(Get-AapLinVms $B | Where-Object { $_.Id -ceq $vmId -or $_.Name -ceq $name })) {
                if ($vm.State -cne 'Off') { & $B.Provider.StopVm @{ VmId = $vm.Id } }
                & $B.Provider.RemoveVm @{ VmId = $vm.Id }
            }
        } catch { $null = $_ }
        Invoke-AapLinFault 'destroy:after-vm'
        try { & $B.Network.Detach @{ VmId = $vmId; VmName = $name; Profile = 'linux' }; $detached = $true } catch { $null = $_ }
        try { Remove-AapLinTree $clone $B.Storage.clone_root.Path } catch { $null = $_ }
        try { Remove-AapLinTree $scratch $B.Storage.scratch_root.Path } catch { $null = $_ }
        $gone = Test-AapLinGone $B $vmId $name $clone $scratch
        if (-not $detached) { $gone = $false }   # check:detach
        if ($gone) { break }
        if ($try -lt $script:TeardownTries) { & $B.Sleep $script:TeardownPauseSeconds }
    }
    [void]$B.Guests.Remove($rid)   # the per-clone channel goes with the clone folder; a remaining one is rebuilt from disk if needed
    if (-not $gone) {
        Write-AapLinFailedOnce $B $r $j 'destroy' $vmId 'retryable' 'the VM, its network or a reservation folder remains after 3 tries'
        if ($r.state -ceq 'deleting') { [void](Set-AapLinState $B $r quarantined -Kind teardown_failed -Reason 'VM, network or reservation folders remain after 3 tries; capacity held') }
        return (New-AapLinResult $r 'held' 'teardown_failed')
    }
    if ($runner -is [string] -and $runner -ceq 'pending') {
        Write-AapLinFailedOnce $B $r $j 'destroy' $vmId 'retryable' 'VM gone; runner release pending'
        return (New-AapLinResult $r 'waiting' 'release_pending')
    }
    if ($runner -is [string] -and $runner -ceq 'uncertain') {
        Write-AapLinFailedOnce $B $r $j 'destroy' $vmId 'fatal' 'VM gone; the broker has no record of an issued lease'
        if ($r.state -ceq 'deleting') { [void](Set-AapLinState $B $r quarantined -Kind teardown_failed -Reason 'runner deregistration uncertain; capacity held') }
        return (New-AapLinResult $r 'held' 'release_uncertain')
    }
    Write-AapLinJournal $B $r 'destroy' 'done' -VmId $vmId -Code 'absent' -Detail 'VM, its files, key, seed and both reservation folders observed absent'
    Invoke-AapLinFault 'destroy:after-done'
    $proof = [ordered]@{ kind = 'vm'; observed_at = (Format-AapLinTime (Get-AapLinNow $B)); vm_absent = $true; disks_absent = $true; vm_files_absent = $true; runner_deregistered = $runner }
    $a = Get-AapLinAllocArgs $B $r
    $c = Complete-AapTeardown @a -Proof $proof
    if ($c.Ok) {
        foreach ($t in $B.Leases, $B.Tried, $B.StatusAt, $B.StatusBusy, $B.Breached, $B.NetAt, $B.Capped, $B.CapSeen, $B.Evidence, $B.BootIntent) { [void]$t.Remove($rid) }
        $next = Get-AapLinField $c 'Reservation'
        if ($null -ne $next) { $r = $next }
        return (New-AapLinResult $r 'destroyed')
    }
    New-AapLinResult $r 'held' $c.Reason
}

# Journals the failed op, walks the slot down to deleting and destroys, in the same step.
function Invoke-AapLinAbandon($B, $r, $j, [string]$Op, [string]$Code, [string]$Detail) {
    $vmId = [string]$j.VmId
    if (-not $vmId -and $B.Guests.ContainsKey([string]$r.reservation_id)) { $vmId = [string]$B.Guests[[string]$r.reservation_id].VmId }
    if ($Op -cne 'create' -and -not $vmId) { $Op = 'create' }   # a record after create must name its VM
    Write-AapLinFailedOnce $B $r $j $Op $vmId $Code $Detail
    $j = Read-AapLinJournal $B $r
    if ($vmId -or $r.state -cne 'creating') {
        $next = Move-AapLinState $B $r 'deleting' $vmId
        if ($null -ne $next) { $r = $next }
    }
    $out = Invoke-AapLinDestroy $B $r $j -Force -Urgent
    if (-not $out.Code) { $out.Code = $Code }
    $out
}

# hostile_guest (allocator.md): immediate and final from every guest state. The slot goes straight to deleting and the VM
# is destroyed even when the allocator call fails; the reason is a fixed code, never guest text.
function Invoke-AapLinHostile($B, $r, $j, [string]$Op, [string]$Code) {
    $rid = [string]$r.reservation_id
    if ($B.Guests.ContainsKey($rid)) { $B.Guests[$rid].Hostile = $Code }
    $vmId = [string]$j.VmId
    if (-not $vmId -and $B.Guests.ContainsKey($rid)) { $vmId = [string]$B.Guests[$rid].VmId }
    if (-not $j.Hostile) { Write-AapLinJournal $B $r $Op 'failed' -VmId $vmId -Code 'hostile_guest' -Detail $Code }
    try {
        $s = Set-AapLinState $B $r quarantined -Kind hostile_guest -Reason $Code -VmId $vmId
        $next = Get-AapLinField $s 'Reservation'
        if ($s.Ok -and $null -ne $next) { $r = $next }
    } catch { $null = $_ }
    $out = Invoke-AapLinDestroy $B $r (Read-AapLinJournal $B $r) -Force -Urgent
    $out.Code = $Code
    $out
}

# The limits backend-lifecycle.md lets end a running VM, checked from the host on every step of a reservation that has a
# VM, with or without a guest channel (a guest that silences its agent is measured all the same): a paused VM, and a
# clone folder over clone_gib or one that cannot be measured (fail closed: a step that threw every tick would leave the
# VM unwatched). The Linux guest writes its job to its root file system, which is the clone's differencing disk, so the
# clone cap is the job's disk cap. A running clone's network that the P10.0 module no longer verifies stops it too
# (host-network-module.md, Consumer obligations 3). Returns the reason, or $null.
function Get-AapLinLimitBreach($B, $r, $j) {
    if (-not $j.VmId) { return $null }
    $vm = @(Get-AapLinVms $B | Where-Object { $_.Id -ceq [string]$j.VmId })
    if (-not $vm.Count) { return $null }
    if ($vm[0].State -like 'Paused*') { return 'vm paused' }   # check:vm-paused
    if ($vm[0].State -ceq 'Running' -and $j.Has['create/done']) {   # check:network-running
        $why = Get-AapLinRunningNetworkProblem $B $r ([string]$j.VmId)
        if ($why) { return $why }
    }
    try { $bytes = [double](& $B.Provider.MeasureBytes @{ Path = (Get-AapLinCloneDir $B $r) }) } catch { return 'clone not measurable' }
    if ($bytes -gt [double]$r.clone_gib * $script:GiB) { return 'clone over cap' }   # check:clone-cap
    $null
}

# ready (the creating state's last op): pin the host key the guest published at first boot, probe until ready (at most
# 15 minutes after boot), eject and delete the seed, journal the lease id (broker INTEGRATION.md, rule 1).
function Step-AapLinReady($B, $r, $j, $g) {
    if (-not $j.Has['ready/intent']) { Write-AapLinJournal $B $r 'ready' 'intent' -VmId $j.VmId }
    $late = ((Get-AapLinNow $B) - $j.BootAt).TotalMinutes -ge $script:BootMinutes
    if (-not (Test-AapLinPinned $g)) {
        $hk = $null
        try { $hk = & $B.Provider.GetHostKey @{ VmId = $j.VmId } } catch { $hk = $null }
        if ($null -eq $hk -or ($hk -is [string] -and $hk -ceq '')) {
            if ($late) { return (Invoke-AapLinAbandon $B $r $j 'ready' 'timeout' 'no host key within 15 minutes of boot') }   # check:boot-deadline
            return (New-AapLinResult $r 'probing' 'host_key_pending')
        }
        if (-not ($hk -is [string]) -or $hk -cnotmatch $script:Ed25519Re) { return (Invoke-AapLinHostile $B $r $j 'ready' 'bad_host_key') }   # check:host-key
        try { Write-AapLinFile (Join-Path $g.Dir 'known_hosts') ([Text.Encoding]::ASCII.GetBytes("aap-guest $hk`n")) }
        catch { return (Invoke-AapLinAbandon $B $r $j 'ready' 'fatal' (Get-AapLinError $_)) }
        Invoke-AapLinFault 'ready:after-pin'
    }
    $p = Invoke-AapLinCommand $B $r 'probe'
    if ($p.Kind -ceq 'hostile') { return (Invoke-AapLinHostile $B $r $j 'ready' $p.Code) }
    $ready = $p.Kind -ceq 'ok' -and $p.Reply['guest_state'] -ceq 'ready'
    if (-not $ready -and ($p.Kind -ceq 'refused' -or $p.Kind -ceq 'error')) { return (Invoke-AapLinAbandon $B $r $j 'ready' 'fatal' "the guest answered the probe with $($p.Kind)") }
    if (-not $ready -and $late) { return (Invoke-AapLinAbandon $B $r $j 'ready' 'timeout' 'no ready reply within 15 minutes of boot') }   # check:boot-deadline
    if (-not $ready) { return (New-AapLinResult $r 'probing' $p.Kind) }
    # First boot is over: the seed's job is done. Eject it, delete it, and check that no medium is left.
    $clone = Get-AapLinCloneDir $B $r
    try {
        & $B.Provider.EjectSeed @{ VmId = $j.VmId }
        Invoke-AapLinFault 'ready:after-eject'
        Remove-AapLinTree (Join-Path $clone 'seed.iso') $clone
        Assert-AapLinVmConfig $B $r $j.VmId $clone (Join-Path $clone 'os.avhdx') ''
    } catch { return (Invoke-AapLinAbandon $B $r $j 'ready' 'fatal' (Get-AapLinError $_)) }
    Write-AapLinJournal $B $r 'ready' 'done' -VmId $j.VmId -Code 'ok' -Detail ('probe ready; seed ejected; lease ' + (New-AapBrokerLeaseId))
    Invoke-AapLinFault 'ready:after-done'
    $null
}

function Step-AapLinCreating($B, $r, $j, $g, [string]$BaseSha256) {
    # An earlier step gave this clone up and its teardown is not finished: finish it, never create again.
    if ($j.Has['create/failed'] -or $j.Has['boot/failed'] -or $j.Has['ready/failed']) {   # check:no-recreate
        if ($j.VmId) { $next = Move-AapLinState $B $r 'deleting' ([string]$j.VmId); if ($null -ne $next) { $r = $next } }
        return (Invoke-AapLinDestroy $B $r $j)
    }
    # A clone created without a usable channel (its key folder or seq mark lost): nobody can reach the guest, so it is
    # never booted or probed (crash table: boot or ready in flight -> re-probe; on timeout destroy).
    if ($j.Has['create/done'] -and $null -eq $g) {   # check:lost-credential
        return (Invoke-AapLinAbandon $B $r $j $(if ($j.Has['boot/intent']) { 'ready' } else { 'boot' }) 'retryable' 'guest channel lost before ready')
    }
    if (-not $j.Has['create/done']) {
        try { [void](Invoke-AapLinCreate $B $r $BaseSha256 $j) }
        catch { return (Invoke-AapLinAbandon $B $r (Read-AapLinJournal $B $r) 'create' 'fatal' (Get-AapLinError $_)) }
        return (New-AapLinResult $r 'created')
    }
    if (-not $j.Has['boot/done']) {
        # The start gate, before anything is journaled for the start: Notes read back, deadline ahead, watchdog healthy.
        # Otherwise the reservation stays creating and the next step asks again (the lifetime cap still ends it).
        $vm = @(Get-AapLinVms $B | Where-Object { $_.Id -ceq [string]$j.VmId })
        $running = $vm.Count -eq 1 -and $vm[0].State -ceq 'Running'
        # L6 d: a boot an earlier supervisor journaled and never finished, whose VM is not running now, is a crash; recovery
        # never starts that VM, whatever the journal says. It is given up and destroyed.
        if ($j.Has['boot/intent'] -and -not $B.BootIntent.ContainsKey([string]$r.reservation_id) -and -not $running) {   # check:boot-replay
            return (Invoke-AapLinAbandon $B $r $j 'boot' 'retryable' 'recovery never starts a VM found off (allocator.md L6 d)')
        }
        if (-not $running) {
            $why = Get-AapLinStartProblem $B $r ([string]$j.VmId)
            if ($why) { $out = New-AapLinResult $r 'waiting' $why.Code; $out.Detail = $why.Detail; return $out }   # check:start-gate
        }
        $B.BootIntent[[string]$r.reservation_id] = $true
        Write-AapLinJournal $B $r 'boot' 'intent' -VmId $j.VmId
        Invoke-AapLinFault 'boot:after-intent'
        # Before the power-on, with the VM Off (host-network-module.md, Consumer obligations 2): Attach again (the same
        # declaration, from the module's journal), the declaration check, Verify and the read-back; a failure stops the
        # start. A VM already running was started after those checks by a step that died before its done record: Verify.
        try {
            $vm = @(Get-AapLinVms $B | Where-Object { $_.Id -ceq [string]$j.VmId })
            $net = Get-AapLinNetRequest $r ([string]$j.VmId)
            if ($vm.Count -eq 1 -and $vm[0].State -ceq 'Running') {
                $problems = @(& $B.Network.Verify $net)
                if ($problems.Count) { throw "AAP_NetworkUntrusted: $(@($problems | ForEach-Object { Get-AapLinLine ([string]$_) 100 }) -join '; ')" }   # check:boot-verify
            } else {
                Assert-AapLinNetwork $B $net (Connect-AapLinNetwork $B $net)
                Invoke-AapLinFault 'boot:after-checks'
                & $B.Provider.StartVm @{ VmId = $j.VmId }
            }
        } catch { return (Invoke-AapLinAbandon $B $r $j 'boot' 'fatal' (Get-AapLinError $_)) }
        # A start that returned at or past the deadline is powered off at once (allocator.md L6 c).
        $capped = Invoke-AapLinLifetimeCap $B $r (Read-AapLinJournal $B $r)
        if ($null -ne $capped) { return $capped }   # check:cap-after-start
        Write-AapLinJournal $B $r 'boot' 'done' -VmId $j.VmId -Code 'ok' -Detail 'VM started'
        Invoke-AapLinFault 'boot:after-done'
        return (New-AapLinResult $r 'booted')
    }
    if (-not $j.Has['ready/done']) {
        $out = Step-AapLinReady $B $r $j $g
        if ($null -ne $out) { return $out }
        $j = Read-AapLinJournal $B $r
    }
    $s = Set-AapLinState $B $r ready -VmId $j.VmId
    $next = Get-AapLinField $s 'Reservation'
    if ($null -ne $next) { $r = $next }
    New-AapLinResult $r 'ready' $s.Reason
}

# run_one: broker lease, deliver_registration, start_runner (then heartbeats until the job ends).
function Invoke-AapLinRunOne($B, $r, $j, $g) {
    $rid = [string]$r.reservation_id
    Write-AapLinJournal $B $r 'run_one' 'intent' -VmId $j.VmId
    Invoke-AapLinFault 'run_one:after-intent'
    $ba = $B.BrokerArgs
    $lease = Invoke-AapBrokerLease -LeaseId $j.LeaseId -ReservationId $rid -LeaseGeneration ([long]$r.lease_generation) -Slot ([int]$r.slot) `
        -RunnerProfile $script:ImageProfile -ImageGeneration ([string]$r.image_generation) @ba
    $B.Leases[$rid] = [string]$lease.Outcome
    $jit = $lease.JitConfig
    try {
        if ($lease.Outcome -ceq 'issued') { Write-AapLinJournal $B $r 'ready' 'done' -VmId $j.VmId -Code 'ok' -Detail $script:LeaseAnswers[0] }
        elseif ($lease.Outcome -ceq 'bad_reply') { Write-AapLinJournal $B $r 'ready' 'done' -VmId $j.VmId -Code 'ok' -Detail $script:LeaseAnswers[1] }
        Invoke-AapLinFault 'run_one:after-lease'
        $j = Read-AapLinJournal $B $r
        if ($lease.Outcome -cne 'issued') { return (Invoke-AapLinAbandon $B $r $j 'run_one' 'retryable' "lease $($lease.Outcome)") }
        # F1 (broker INTEGRATION.md): the JIT config goes only to the channel of this reservation's own VM, created and
        # booted here from the base, never run a job, not hostile, before the lease's delivery deadline.
        $fits = $lease.RunnerName -ceq (Get-AapLinVmName $r) -and [string]$g.VmId -ceq [string]$j.VmId -and -not $g.Started -and -not $j.Started -and -not $g.Hostile -and
            (Get-AapLinNow $B) -lt (ConvertTo-AapLinUtc $lease.ExpiresAt)
        if (-not $fits) { return (Invoke-AapLinAbandon $B $r $j 'run_one' 'fatal' 'the lease does not fit this VM') }   # check:jit-target
        $d = Invoke-AapLinCommand $B $r 'deliver_registration' $jit
        Invoke-AapLinFault 'run_one:after-deliver'
        if ($d.Kind -ceq 'hostile') { return (Invoke-AapLinHostile $B $r $j 'run_one' $d.Code) }
        if ($d.Kind -cne 'ok') { return (Invoke-AapLinAbandon $B $r $j 'run_one' 'fatal' "deliver_registration $($d.Kind)") }
        $s = Invoke-AapLinCommand $B $r 'start_runner'
        if ($s.Kind -ceq 'hostile') { return (Invoke-AapLinHostile $B $r $j 'run_one' $s.Code) }
        if ($s.Kind -cne 'ok') { return (Invoke-AapLinAbandon $B $r $j 'run_one' 'fatal' "start_runner $($s.Kind)") }
        $g.Started = $true
        Write-AapLinJournal $B $r 'ready' 'done' -VmId $j.VmId -Code 'ok' -Detail $script:StartedDetail
        Invoke-AapLinFault 'run_one:after-start'
        New-AapLinResult $r 'running'
    } finally {
        if ($null -ne $jit) { $jit.Clear() }   # check:jit-clear
    }
}

# collect: the agent's bounded summary (the guest_reply itself: state, runner exit code, diag), then deleting and destroy.
function Step-AapLinCollect($B, $r, $j, $g) {
    $summary = $null
    if (-not $j.Has['collect/done'] -and -not $j.Has['collect/failed']) {
        Write-AapLinJournal $B $r 'collect' 'intent' -VmId $j.VmId
        Invoke-AapLinFault 'collect:after-intent'
        if ($null -ne $g -and $g.Started -and -not $g.Hostile) {
            $c = Invoke-AapLinCommand $B $r 'collect'
            if ($c.Kind -ceq 'hostile') { return (Invoke-AapLinHostile $B $r $j 'collect' $c.Code) }
            if ($c.Kind -ceq 'ok') {
                $summary = [pscustomobject]@{ GuestState = [string]$c.Reply['guest_state']; RunnerExitCode = $c.Reply['runner_exit_code']; Diag = [string]$c.Reply['diag'] }
                Write-AapLinJournal $B $r 'collect' 'done' -VmId $j.VmId -Code 'ok' -Detail "summary collected; runner exit $($c.Reply['runner_exit_code'])"
            } else {
                Write-AapLinJournal $B $r 'collect' 'failed' -VmId $j.VmId -Code 'retryable' -Detail "no summary: $($c.Kind)"
            }
        } else {
            Write-AapLinJournal $B $r 'collect' 'done' -VmId $j.VmId -Code 'ok' -Detail 'no guest channel; no summary'
        }
    }
    $next = Move-AapLinState $B $r 'deleting'
    if ($null -eq $next) { return (New-AapLinResult $r 'held' 'allocator' $summary) }
    $out = Invoke-AapLinDestroy $B $next (Read-AapLinJournal $B $next) -Force
    $out.Summary = $summary
    $out
}

# ready (runner started), busy, draining: one heartbeat. The guest's `status` reply proves liveness over this VM's own
# channel; whether a job runs comes from the broker's record of the runner, never from the guest.
function Step-AapLinRunning($B, $r, $j, $g) {
    if ($j.Has['run_one/done'] -or $j.Has['run_one/failed']) {
        if ($j.Has['run_one/failed']) { return (Invoke-AapLinAbandon $B $r $j 'run_one' 'retryable' 'run_one failed earlier') }
        $next = Move-AapLinState $B $r 'collecting'
        if ($null -eq $next) { return (New-AapLinResult $r 'held' 'allocator') }
        return (Step-AapLinCollect $B $next $j $g)
    }
    if (-not $j.Has['run_one/intent']) {
        # No lease was ever asked for. Without a guest channel nobody can deliver one: retire it.
        if ($null -eq $g -or $r.state -cne 'ready') { return (Invoke-AapLinAbandon $B $r $j 'run_one' 'retryable' 'no lease and no guest channel') }
        return (Invoke-AapLinRunOne $B $r $j $g)
    }
    $rid = [string]$r.reservation_id
    $now = Get-AapLinNow $B
    if ($B.StatusAt.ContainsKey($rid) -and ($now - $B.StatusAt[$rid]).TotalSeconds -lt $B.StatusSeconds) {
        return (New-AapLinResult $r $(if ($B.StatusBusy[$rid]) { 'busy' } else { 'listening' }) 'not_due')
    }
    $B.StatusAt[$rid] = $now
    $live = $null -ne $g -and $g.Started -and -not $g.Hostile
    $hb = $null
    if ($live) {
        $hb = Invoke-AapLinCommand $B $r 'status'
        if ($hb.Kind -ceq 'hostile') { return (Invoke-AapLinHostile $B $r $j 'run_one' $hb.Code) }
    }
    $ba = $B.BrokerArgs
    $bs = Invoke-AapBrokerStatus -LeaseId $j.LeaseId @ba
    $known = $bs.Outcome -ceq 'ok'
    $busy = $known -and $bs.RunnerBusy -eq $true
    $B.StatusBusy[$rid] = $busy
    if ($live -and $hb.Kind -ceq 'ok') {
        $a = Get-AapLinAllocArgs $B $r
        [void](Update-AapHeartbeat @a -JobRunning:$busy)
    }
    if ($known -and -not $busy -and ($bs.RunnerStatus -ceq 'absent' -or $bs.RunnerStatus -ceq 'offline')) {
        Write-AapLinJournal $B $r 'run_one' 'done' -VmId $j.VmId -Code 'ok' -Detail "runner $($bs.RunnerStatus) and idle: job ended"
        $next = Move-AapLinState $B $r 'collecting'
        if ($null -eq $next) { return (New-AapLinResult $r 'held' 'allocator') }
        return (Step-AapLinCollect $B $next (Read-AapLinJournal $B $next) $g)
    }
    $unknown = $bs.Outcome -ceq 'refused' -and $bs.Reason -ceq 'not_found'
    if (($known -and -not $busy -and ($r.state -ceq 'draining' -or -not $live)) -or (-not $live -and $unknown)) {
        # drain: a listening runner without a job is stopped (deregistered by the release in destroy); a busy runner is
        # never touched. Without a guest channel the same holds for ready, and for a lease the broker never recorded.
        Write-AapLinJournal $B $r 'drain' 'intent' -VmId $j.VmId
        Invoke-AapLinFault 'drain:after-intent'
        Write-AapLinJournal $B $r 'drain' 'done' -VmId $j.VmId -Code 'ok' -Detail $(if ($known) { $script:DrainOnline } else { 'the broker has no runner for this lease; released at destroy' })
        $next = Move-AapLinState $B $r 'collecting'
        if ($null -eq $next) { return (New-AapLinResult $r 'held' 'allocator') }
        return (Step-AapLinCollect $B $next (Read-AapLinJournal $B $next) $g)
    }
    $code = $null
    if ($live) { $code = $hb.Kind }
    New-AapLinResult $r $(if ($busy) { 'busy' } else { 'listening' }) $code
}

function Step-AapLinQuarantined($B, $r, $j, $g) {
    $kind = [string](Get-AapLinField $r 'quarantine_kind')
    if ($kind -ceq 'heartbeat' -and $null -ne $g -and $g.Started -and -not $g.Hostile -and $j.LeaseId) {
        $hb = Invoke-AapLinCommand $B $r 'status'
        if ($hb.Kind -ceq 'hostile') { return (Invoke-AapLinHostile $B $r $j 'run_one' $hb.Code) }
        if ($hb.Kind -ceq 'ok') {
            $ba = $B.BrokerArgs
            $bs = Invoke-AapBrokerStatus -LeaseId $j.LeaseId @ba
            if ($bs.Outcome -cne 'ok') { return (New-AapLinResult $r 'held' 'broker_unavailable') }   # check:recover-broker
            $a = Get-AapLinAllocArgs $B $r
            $h = Update-AapHeartbeat @a -JobRunning:($bs.RunnerBusy -eq $true)
            $next = Get-AapLinField $h 'Reservation'
            if ($null -ne $next) { $r = $next }
            return (New-AapLinResult $r 'recovered')
        }
    }
    # heartbeat without a channel, crash and unknown_vm: held; Invoke-AapReconcile decides on the broker's status.
    New-AapLinResult $r 'held' $kind
}

# ---- public -------------------------------------------------------------------------------------------------------------

function New-AapLinBackend {
    <# The backend context every other call takes. Production: -Provider (New-AapLinHyperVProvider) and -Network (the P10.0
       module's Attach, Detach, Verify); everything else defaults to the fixed production paths. Without -Network, no
       guest can be attached and every create fails closed. #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][hashtable]$Provider,
        [hashtable]$Network = $null,
        [scriptblock]$Transport = $null,
        [scriptblock]$BrokerInvoker = $null,
        [string]$Distro = 'aap-runner',
        [string]$AllocatorRoot = 'C:\ProgramData\aap-runner\capacity',
        [string]$JournalRoot = 'C:\ProgramData\aap-runner\capacity\journal',
        [string]$StoragePath = 'C:\ProgramData\aap-runner\capacity\storage.json',
        [scriptblock]$Clock = $null,
        [scriptblock]$Sleep = $null,
        [int]$LockTimeoutSeconds = 30,
        # The lifetime cap (allocator.md, Hard VM lifetime cap): the effective vm_lifetime_cap_hours (the supervisor reads
        # the settings; $B.CapHours may be changed between steps), the host watchdog's clock record for the start gate
        # (B7; none: no VM starts), the supervisor's clock-safety decision at its start (L7: 'host_reboot' after a boot id
        # change, 'clock_unavailable' when its clock record was lost), and the boot-bound millisecond counter (a test hook).
        [ValidateRange(1, 6)][int]$CapHours = 6,
        [string]$WatchdogClockPath = '',
        [ValidateSet('', 'host_reboot', 'clock_unavailable', IgnoreCase = $false)][string]$ClockSafety = '',
        [scriptblock]$Monotonic = $null,
        [switch]$RelaxedTrustForTests
    )
    $missing = @($script:ProviderOps | Where-Object { -not ($Provider[$_] -is [scriptblock]) })
    if ($missing.Count) { throw "AAP_ProviderInvalid: missing $($missing -join ', ')" }   # check:provider-ops
    if ($null -eq $Network) {
        $Network = @{
            Attach = { param($a) throw 'AAP_NetworkUnavailable: the P10.0 guest network module is not installed; no guest is attached' }
            Detach = { param($a) }
            Verify = { param($a) 'the P10.0 guest network module is not installed' }
        }
    }
    $missing = @($script:NetworkOps | Where-Object { -not ($Network[$_] -is [scriptblock]) })
    if ($missing.Count) { throw "AAP_NetworkInvalid: missing $($missing -join ', ')" }
    if ((Get-AapLinPathKind $script:RelayScript) -cne 'file') { throw "AAP_RelayMissing: the hvsocket relay is not beside the module: $($script:RelayScript)" }
    $storage = Read-AapLinStorage $StoragePath
    $trusted = $script:AdminSids
    if ($RelaxedTrustForTests) {
        $why = Get-AapLinRelaxedProblem @($AllocatorRoot, $JournalRoot, $storage.base_root.Path, $storage.clone_root.Path, $storage.scratch_root.Path)
        if ($why) { throw "AAP_RelaxedRefused: $why" }
        $trusted = $script:AdminSids + [Security.Principal.WindowsIdentity]::GetCurrent().User.Value
        Write-Warning 'AapLinBackend: relaxed trust for tests; the current user is trusted and ancestor ACLs are not checked'
    }
    $broker = @{ Distro = $Distro }
    if ($null -ne $BrokerInvoker) { $broker.Invoker = $BrokerInvoker }
    $B = @{
        Provider = $Provider; Network = $Network; Storage = $storage; AllocatorRoot = $AllocatorRoot; JournalRoot = $JournalRoot
        AllocArgs = @{ LockTimeoutSeconds = $LockTimeoutSeconds; RelaxedTrustForTests = [bool]$RelaxedTrustForTests }
        BrokerArgs = $broker; Relaxed = [bool]$RelaxedTrustForTests; TrustedSids = $trusted
        Transport = $Transport; Now = $Clock; Sleep = $Sleep; StatusSeconds = $script:StatusSeconds
        Guests = @{}; Leases = @{}; Tried = @{}; StatusAt = @{}; StatusBusy = @{}; Breached = @{}; NetAt = @{}
        CapHours = $CapHours; WatchdogClockPath = $WatchdogClockPath; ClockSafety = $ClockSafety; Mono = $Monotonic; High = $null
        Capped = @{}; CapSeen = @{}; Evidence = @{}; BootIntent = @{}; CapHoursWarned = $null
    }
    if ($null -eq $B.Mono) { $B.Mono = { [long]([Diagnostics.Stopwatch]::GetTimestamp() / ([Diagnostics.Stopwatch]::Frequency / 1000.0)) } }
    if ($null -eq $B.Transport) { $B.Transport = { param($Call) Invoke-AapLinGuestChild $Call } }
    if ($null -eq $B.Now) { $B.Now = { [DateTime]::UtcNow } }
    if ($null -eq $B.Sleep) { $B.Sleep = { param($Seconds) Start-Sleep -Seconds $Seconds } }
    # A new journal folder, and its compile folder, are admin-only from their creation (P09's New-AapFolder): protected
    # DACL, SYSTEM and Administrators full control; relaxed mode adds the current user so an unelevated test can write.
    $sddl = 'D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)'
    if ($RelaxedTrustForTests) { $sddl += "(A;OICI;FA;;;$([Security.Principal.WindowsIdentity]::GetCurrent().User.Value))" }
    $sec = New-Object Security.AccessControl.DirectorySecurity
    $sec.SetSecurityDescriptorSddlForm($sddl)
    if ((Get-AapLinPathKind $JournalRoot) -ceq 'absent' -and (Get-AapLinPathKind (Split-Path -Parent $JournalRoot)) -ceq 'dir') { New-AapLinDir $JournalRoot $sec }
    $problems = @(Get-AapLinTrustProblem $B $JournalRoot)
    if ($problems.Count) { throw "AAP_JournalUntrusted: $($problems -join '; ')" }   # check:journal-trust
    # Windows PowerShell compiles Add-Type through csc.exe with temporary files under %TMP%: in the elevated supervisor
    # they must not sit in a folder a user can write, or a planted file could join the compiled types.
    $compile = Join-Path $JournalRoot 'compile'
    if ((Get-AapLinPathKind $compile) -ceq 'absent') { New-AapLinDir $compile $sec }
    $problems = @(Get-AapLinTrustProblem $B $compile)
    if ($problems.Count) { throw "AAP_CompileUntrusted: $($problems -join '; ')" }   # check:compile-trust
    if (-not ('AapLinJobObject' -as [type])) {
        $saved = @($env:TMP, $env:TEMP)
        try { $env:TMP = $compile; $env:TEMP = $compile; Add-Type -TypeDefinition $script:TypeSource }
        finally { $env:TMP = $saved[0]; $env:TEMP = $saved[1] }
    }
    $B
}

function Invoke-AapLinStep {
    <# One step for one live linux hyperv-vm reservation (Get-AapAllocatorState .State.reservations), chosen by its
       allocator state and its journal. Call it for every such reservation on every supervisor tick; after a reconcile,
       its destroy and replay actions are carried out by the next step of the named reservation. -BaseSha256 is the
       generation's pinned hash (approved-images.json); only create uses it. Returns ReservationId, LeaseGeneration,
       Action, State, Code (a fixed code) and Summary (collect only; guest-authored text, bounded and printable). #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable]$Backend, [Parameter(Mandatory)]$Reservation, [string]$BaseSha256 = '',
        $CatalogGuestRevision = $null, $ApprovedGuestRevision = $null)
    $B = $Backend
    $r = $Reservation
    if ((Get-AapLinField $r 'profile') -cne 'linux' -or (Get-AapLinField $r 'backend') -cne 'hyperv-vm' -or [string](Get-AapLinField $r 'reservation_id') -cnotmatch $script:RidRe) {
        throw 'AAP_BadRequest: the Linux backend steps linux hyperv-vm reservations only'
    }
    $lock = $null
    try { $lock = New-Object IO.FileStream((Join-Path $B.JournalRoot ([string]$r.reservation_id + '.lock')), [IO.FileMode]::OpenOrCreate, [IO.FileAccess]::ReadWrite, [IO.FileShare]::None, 1, [IO.FileOptions]::DeleteOnClose) } catch { $lock = $null }
    if ($null -eq $lock) { return (New-AapLinResult $r 'held' 'step_in_progress') }   # check:step-lock
    try { Step-AapLinOne $B $r $BaseSha256 $CatalogGuestRevision $ApprovedGuestRevision } finally { $lock.Dispose() }
}

function Step-AapLinOne($B, $r, [string]$BaseSha256, $CatalogGuestRevision, $ApprovedGuestRevision) {
    $j = $null
    $unreadable = $null
    try { $j = Read-AapLinJournal $B $r } catch { $unreadable = $_ }
    # The lifetime cap first, before anything else the step might do (allocator.md L3, L4); its power-off needs no journal.
    $capped = $null
    try { $capped = Invoke-AapLinLifetimeCap $B $r $j }
    catch { $capped = Invoke-AapLinCapEmergency $B $r $j (Get-AapLinError $_) }   # never fail open
    if ($null -ne $capped -and $null -ne $j) { return $capped }   # check:cap-first
    if ($null -ne $unreadable) {
        # Journal unreadable: quarantine the reservation, capacity held (backend-lifecycle.md, crash table); a deleting
        # one as teardown_failed (the only quarantine a deleting slot may enter), never left deleting for ever. A capped
        # one keeps its own code (cap_breach stays cap_breach) and evidence; a refused quarantine is said, not dropped.
        $s = $(if ($null -ne $capped) { [string]$capped.State } else { [string]$r.state })
        $qk = $(if ($s -ceq 'deleting') { 'teardown_failed' } else { 'crash' })
        $q = $null
        if (@('creating', 'ready', 'busy', 'draining', 'collecting', 'deleting') -ccontains $s) {   # check:journal-deleting
            try { $q = Set-AapLinState $B $r quarantined -Kind $qk -Reason 'journal unreadable; capacity held' } catch { $q = [pscustomobject]@{ Ok = $false; Reason = (Get-AapLinError $_) } }
        }
        $out = $capped
        if ($null -eq $out) { $out = New-AapLinResult $r 'held' 'journal_unreadable' }
        if ($null -ne $q -and -not $q.Ok) { $out.Detail = Get-AapLinLine ((@($out.Detail, "quarantine refused: $($q.Reason)") | Where-Object { $_ }) -join '; ') 400 }
        return $out
    }
    # The wire is still schema 1: a guest reply cannot certify its agent revision. Only these admin-owned pins admit it.
    # Check every new/recovered create before its intent, limits, VM/disk/key/seed operations or any guest command.
    if ($r.state -ceq 'creating' -and -not $j.Has['create/done'] -and -not $j.Has['create/failed'] -and -not $j.Has['boot/failed'] -and -not $j.Has['ready/failed']) {
        if (-not ($CatalogGuestRevision -is [int] -or $CatalogGuestRevision -is [long]) -or -not ($ApprovedGuestRevision -is [int] -or $ApprovedGuestRevision -is [long]) -or $CatalogGuestRevision -ne 2 -or $ApprovedGuestRevision -ne 2) {   # check:guest-revision
            throw 'AAP_GuestRevision: catalog and approved guest-agent revisions must both be integer 2'
        }
    }
    $g = Get-AapLinGuest $B $r $j
    # A hostile guest is final: once journaled, the slot only goes down, even after a crash between the journal and the
    # allocator write.
    $kind = [string](Get-AapLinField $r 'quarantine_kind')
    if ($j.Hostile -and $r.state -cne 'deleting' -and $r.state -cne 'reconciled' -and -not ($r.state -ceq 'quarantined' -and @('hostile_guest', 'teardown_failed') -ccontains $kind)) {   # check:hostile-final
        return (Invoke-AapLinHostile $B $r $j 'run_one' $j.Hostile)
    }
    $toDestroy = [string]$r.state -ceq 'deleting' -or ([string]$r.state -ceq 'quarantined' -and ($kind -ceq 'hostile_guest' -or $kind -ceq 'teardown_failed' -or $j.Has['destroy/intent']))
    if ($toDestroy) { return (Invoke-AapLinDestroy $B $r $j) }   # destroy holds the kept VM to its limits itself
    if ([string]$r.state -ceq 'reconciled') { return (New-AapLinResult $r 'held' 'state') }
    # The host-side limits, on every step of every other state with a VM, guest channel or not, before anything else:
    # creating (probing for up to 15 minutes), ready, busy, draining, collecting and every quarantine.
    $breach = Get-AapLinLimitBreach $B $r $j
    if ($breach) {   # check:limits-every-step
        $op = $(if ([string]$r.state -ceq 'creating') { $(if ($j.Has['boot/done']) { 'ready' } elseif ($j.Has['create/done']) { 'boot' } else { 'create' }) } else { 'run_one' })
        return (Invoke-AapLinAbandon $B $r $j $op 'fatal' $breach)
    }
    switch -CaseSensitive ([string]$r.state) {
        'creating' { return (Step-AapLinCreating $B $r $j $g $BaseSha256) }
        'ready' { return (Step-AapLinRunning $B $r $j $g) }
        'busy' { return (Step-AapLinRunning $B $r $j $g) }
        'draining' { return (Step-AapLinRunning $B $r $j $g) }
        'collecting' { return (Step-AapLinCollect $B $r $j $g) }
        'quarantined' { return (Step-AapLinQuarantined $B $r $j $g) }
    }
    New-AapLinResult $r 'held' 'state'
}

function Invoke-AapLinCapPass {
    <# Due power-offs first (allocator.md L3, rule 1): at every tick, before stepping any reservation, decide the lifetime
       cap of every live linux hyperv-vm reservation given, latch the due ones and power their VMs off, before any teardown,
       release or guest call of any of them. Invoke-AapLinStep then persists and tears each down. Returns the ids latched. #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable]$Backend, [Parameter(Mandatory)][AllowEmptyCollection()][object[]]$Reservations)
    foreach ($r in $Reservations) {
        if ((Get-AapLinField $r 'profile') -cne 'linux' -or (Get-AapLinField $r 'backend') -cne 'hyperv-vm') { continue }
        if ([string](Get-AapLinField $r 'reservation_id') -cnotmatch $script:RidRe) {   # check:pass-rid
            Write-Warning "AapLinBackend: $(Get-AapLinLine ([string](Get-AapLinField $r 'reservation_id')) 40) is not a reservation id; skipped by the cap pass"
            continue
        }
        $j = $null
        try { $j = Read-AapLinJournal $Backend $r } catch { $j = $null }
        # One reservation that throws stops neither the others nor its own power-off.
        $c = $null
        try { $c = Invoke-AapLinCapPowerOff $Backend $r $j } catch { $c = Invoke-AapLinCapEmergency $Backend $r $j (Get-AapLinError $_) }
        if ($null -ne $c) { [string]$r.reservation_id }
    }
}

function Get-AapLinInventory {
    <# The -Inventory callback of Invoke-AapReconcile (allocator.md, Reconcile): every VM named aap-(w|l)-<slot>-..., every
       reservation folder under clone_root and scratch_root, every journaled reservation. One host, one list: the Windows
       backend's Get-AapWinInventory lists the same; P12 calls one of them. Complete or throws: a listing error, an entry in
       a tier root that is not a plain reservation folder, or a VM entry without name or id throws. #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable]$Backend)
    $B = $Backend
    $vms = @(Get-AapLinVms $B | Where-Object { $_.Name -cmatch '^aap-(w|l)-[1-5]-' } | ForEach-Object {
            @{ name = $_.Name; vm_id = $_.Id; cpus = [int]$_.Cpus; mem_gib = [int]$_.MemGib } })
    $folders = New-Object Collections.Generic.List[object]
    foreach ($t in 'clone_root', 'scratch_root') {
        foreach ($e in [IO.Directory]::GetFileSystemEntries($B.Storage[$t].Path)) {
            $leaf = Split-Path -Leaf $e
            if ((Get-AapLinPathKind $e) -cne 'dir' -or $leaf -cnotmatch $script:RidRe) { throw "AAP_InventoryIncomplete: not a reservation folder: $e" }   # check:inventory-strict
            if (-not $folders.Contains($leaf)) { $folders.Add($leaf) }
        }
    }
    $journaled = @([IO.Directory]::GetFiles($B.JournalRoot, '*.jsonl') | ForEach-Object { Split-Path -Leaf $_ } |
            Where-Object { $_ -cmatch '^r-[0-9a-f]{16}\.jsonl\z' } | ForEach-Object { $_.Substring(0, 18) })
    @{ vms = [object[]]$vms; folders = [object[]]$folders.ToArray(); journaled = [object[]]$journaled }
}

function Get-AapLinBrokerStatus {
    <# The -BrokerStatus callback of Invoke-AapReconcile: the broker's read-only status of the reservation's runner, by the
       lease id in its journal. No lease ever asked for: absent. A journaled job end: job_ended. Broker unavailable or the
       journal unreadable: $null (the slot stays held). #>
    [CmdletBinding()]
    param([Parameter(Mandatory)][hashtable]$Backend, [Parameter(Mandatory)]$Reservation)
    try { $j = Read-AapLinJournal $Backend $Reservation } catch { return $null }
    if ($j.Has['run_one/done']) { return @{ status = 'absent'; busy = $false; job_ended = $true } }
    if (-not $j.Has['run_one/intent']) { return @{ status = 'absent'; busy = $false; job_ended = $false } }
    if (-not $j.LeaseId) { return $null }
    $ba = $Backend.BrokerArgs
    $s = Invoke-AapBrokerStatus -LeaseId $j.LeaseId @ba
    if ($s.Outcome -cne 'ok') { return $null }
    @{ status = [string]$s.RunnerStatus; busy = [bool]$s.RunnerBusy; job_ended = $false }
}

Export-ModuleMember -Function New-AapLinBackend, Invoke-AapLinStep, Invoke-AapLinCapPass, Get-AapLinInventory, Get-AapLinBrokerStatus, Get-AapLinStorageProblem,
    Get-AapLinHostProblem, New-AapLinSeed
