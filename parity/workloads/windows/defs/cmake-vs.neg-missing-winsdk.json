{
  "id": "windows/cmake-vs.neg-missing-winsdk",
  "description": "Negative control: MSBuild asked for a Windows SDK the profile does not have must fail.",
  "expected_exit_codes": [
    1
  ],
  "timeout_s": 600,
  "commands": [
    [
      "powershell.exe",
      "-NoProfile",
      "-NonInteractive",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "{fixtures}/../../../../parity/workloads/windows/cmake/run.ps1",
      "-Work",
      "{work}",
      "-Id",
      "windows/cmake-vs.neg-missing-winsdk",
      "-Generator",
      "vs",
      "-Sabotage",
      "missing-winsdk"
    ]
  ],
  "expected_first_error": {
    "contains": "MSB8036: The Windows SDK version 10.0.99999.0 was not found"
  },
  "claim_success_regex": "^workload \\S+: all oracle checks met$",
  "claim_failure_regex": "^workload \\S+: \\d+ oracle check\\(s\\) not met$"
}
