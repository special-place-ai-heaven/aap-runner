{
  "id": "windows/toolchain-versions.neg-no-llvm-on-path",
  "description": "Negative control: LLVM missing from PATH must fail the version oracle.",
  "expected_exit_codes": [
    1
  ],
  "timeout_s": 300,
  "commands": [
    [
      "powershell.exe",
      "-NoProfile",
      "-NonInteractive",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "{fixtures}/../../../../parity/workloads/windows/versions/run.ps1",
      "-Work",
      "{work}",
      "-Id",
      "windows/toolchain-versions.neg-no-llvm-on-path",
      "-Sabotage",
      "no-llvm-on-path"
    ]
  ],
  "expected_first_error": {
    "contains": "oracle version.llvm expected '20.1.8' observed ''"
  },
  "claim_success_regex": "^workload \\S+: all oracle checks met$",
  "claim_failure_regex": "^workload \\S+: \\d+ oracle check\\(s\\) not met$"
}
