{
  "id": "windows/clang-cl.neg-no-sdk-include",
  "description": "Negative control: clang-cl with INCLUDE pointing at an empty folder (no SDK headers) must fail.",
  "expected_exit_codes": [
    1
  ],
  "timeout_s": 300,
  "commands": [
    [
      "powershell.exe",
      "-NoProfile",
      "-NonInteractive",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "{fixtures}/../../../../parity/workloads/windows/clang-cl/run.ps1",
      "-Work",
      "{work}",
      "-Id",
      "windows/clang-cl.neg-no-sdk-include",
      "-Sabotage",
      "no-sdk-include"
    ]
  ],
  "expected_first_error": {
    "contains": "'windows.h' file not found"
  },
  "claim_success_regex": "^workload \\S+: all oracle checks met$",
  "claim_failure_regex": "^workload \\S+: \\d+ oracle check\\(s\\) not met$"
}
