{
  "id": "linux/gcc.neg-no-openssl-headers",
  "description": "Negative control: A sysroot without the OpenSSL headers (missing libssl-dev) must fail.",
  "expected_exit_codes": [
    1
  ],
  "timeout_s": 300,
  "commands": [
    [
      "bash",
      "{fixtures}/../../../../parity/workloads/linux/gcc/run.sh",
      "--work",
      "{work}",
      "--id",
      "linux/gcc.neg-no-openssl-headers",
      "--cc",
      "gcc",
      "--sabotage",
      "no-openssl-headers"
    ]
  ],
  "expected_first_error": {
    "contains": "fatal error: openssl/evp.h: No such file or directory"
  },
  "claim_success_regex": "^workload \\S+: all oracle checks met$",
  "claim_failure_regex": "^workload \\S+: \\d+ oracle check\\(s\\) not met$"
}
