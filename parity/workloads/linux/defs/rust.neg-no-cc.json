{
  "id": "linux/rust.neg-no-cc",
  "description": "Negative control: cargo on a PATH without cc (rustc's linker and the build script's compiler) must fail.",
  "expected_exit_codes": [
    1
  ],
  "timeout_s": 300,
  "commands": [
    [
      "bash",
      "{fixtures}/../../../../parity/workloads/linux/rust/run.sh",
      "--work",
      "{work}",
      "--id",
      "linux/rust.neg-no-cc",
      "--sabotage",
      "no-cc"
    ]
  ],
  "expected_first_error": {
    "contains": "error: linker `cc` not found"
  },
  "claim_success_regex": "^workload \\S+: all oracle checks met$",
  "claim_failure_regex": "^workload \\S+: \\d+ oracle check\\(s\\) not met$"
}
