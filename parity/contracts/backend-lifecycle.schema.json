{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/special-place-ai-heaven/aap-runner/blob/main/parity/contracts/backend-lifecycle.schema.json",
  "title": "Backend provider journal record (one JSON line per record), measured per-tier disk budget, and the storage tier configuration",
  "x-contract-version": 3,
  "x-owner": "P10 (Windows provider), P11 (Linux provider); budgets measured by P06/P07; storage document written by the P19 elevated helper; consumers P09, P12, P19, P20, P22, P25",
  "oneOf": [
    {
      "$ref": "#/$defs/op"
    },
    {
      "$ref": "#/$defs/budget"
    },
    {
      "$ref": "#/$defs/storage"
    }
  ],
  "$defs": {
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^(win25-vs2026-x64|ubuntu-24.04-x64)/[0-9]{8}\\.[0-9]+\\.[0-9]+-aap\\.[0-9]+$"
    },
    "relpath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*\\.(vhdx|avhdx|iso)$",
      "not": {
        "pattern": "(^|/)\\.\\.?(/|$)"
      },
      "description": "Relative to the root of the disk role's tier: base_ref -> base_root, os_diff and seed -> clone_root, scratch -> scratch_root."
    },
    "op": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "reservation_id",
        "lease_generation",
        "backend",
        "profile",
        "image_generation",
        "op",
        "idempotency_key",
        "phase",
        "at",
        "vm",
        "disks",
        "result"
      ],
      "properties": {
        "schema": {
          "const": 2
        },
        "kind": {
          "const": "op"
        },
        "reservation_id": {
          "type": "string",
          "pattern": "^r-[0-9a-f]{16}$"
        },
        "lease_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999999
        },
        "backend": {
          "enum": [
            "hyperv-vm",
            "wsl-legacy"
          ]
        },
        "profile": {
          "enum": [
            "linux",
            "windows"
          ]
        },
        "image_generation": {
          "type": "string",
          "maxLength": 80
        },
        "op": {
          "enum": [
            "create",
            "boot",
            "ready",
            "run_one",
            "drain",
            "collect",
            "destroy",
            "reconcile"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "maxLength": 80
        },
        "phase": {
          "enum": [
            "intent",
            "done",
            "failed"
          ]
        },
        "at": {
          "$ref": "#/$defs/time"
        },
        "vm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vm_id",
            "vm_name"
          ],
          "properties": {
            "vm_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "vm_name": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^aap-(w|l)-[1-5]-[0-9]{1,9}-[0-9a-f]{8}$"
            }
          }
        },
        "disks": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "path",
              "sha256"
            ],
            "properties": {
              "role": {
                "enum": [
                  "base_ref",
                  "os_diff",
                  "scratch",
                  "seed"
                ]
              },
              "path": {
                "$ref": "#/$defs/relpath"
              },
              "sha256": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/sha256"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "role": {
                      "const": "base_ref"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "sha256": {
                      "$ref": "#/$defs/sha256"
                    }
                  }
                }
              }
            ]
          }
        },
        "result": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "detail"
              ],
              "properties": {
                "code": {
                  "enum": [
                    "ok",
                    "absent",
                    "retryable",
                    "fatal",
                    "timeout",
                    "hostile_guest",
                    "vm_lifetime_cap"
                  ]
                },
                "detail": {
                  "type": "string",
                  "maxLength": 200,
                  "pattern": "^[ -~]*$"
                }
              }
            }
          ]
        },
        "lifetime_cap": {
          "$ref": "#/$defs/lifetime_cap"
        }
      }
    },
    "lifetime_cap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cap_hours",
        "started_utc",
        "deadline_utc",
        "elapsed_s",
        "trigger",
        "power_off_utc",
        "reason"
      ],
      "description": "After-power-off evidence (allocator.md L4/L7). trigger is deadline, host_reboot or clock_unavailable. Only deadline requires known elapsed_s at least cap_hours hours; safety triggers allow nonnegative measured age below the cap or null when unknown. power_off_utc and this cap intent's at are sampled from the same nondecreasing per-reservation high-water evidence clock, floored at started_utc and advanced by boot-bound monotonic time when available, never raw rolled-back wall samples. at is sampled after issuance with a floor of power_off_utc. These timestamp floors establish ordering, not measured elapsed age. A running VM after failed E2 remains an explicit cap_breach, not successful termination.",
      "properties": {
        "cap_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "started_utc": {
          "$ref": "#/$defs/time"
        },
        "deadline_utc": {
          "$ref": "#/$defs/time"
        },
        "elapsed_s": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 31536000
        },
        "trigger": {
          "enum": ["deadline", "clock_unavailable", "host_reboot"]
        },
        "power_off_utc": {
          "$ref": "#/$defs/time"
        },
        "reason": {
          "const": "vm_lifetime_cap"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "profile",
        "image_generation",
        "measured",
        "evidence_ref",
        "measured_at",
        "base_gib",
        "clone_peak_gib",
        "clone_gib_max",
        "scratch_peak_gib",
        "scratch_gib_max",
        "staging_gib",
        "replacement_gib",
        "rollback_retained_generations",
        "boot_mem_overhead_mib"
      ],
      "properties": {
        "schema": {
          "const": 2
        },
        "kind": {
          "const": "budget"
        },
        "profile": {
          "enum": [
            "linux",
            "windows"
          ]
        },
        "image_generation": {
          "$ref": "#/$defs/generation"
        },
        "measured": {
          "const": true
        },
        "evidence_ref": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^evidence/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        "measured_at": {
          "$ref": "#/$defs/time"
        },
        "base_gib": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "clone_peak_gib": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "clone_gib_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "description": "Per-reservation cap on the clone tier volume (differencing disk, VM files, seed); at least the measured peak. Admission counts it."
        },
        "scratch_peak_gib": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "scratch_gib_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096,
          "description": "Per-reservation cap on the scratch tier volume (the scratch VHDX maximum size plus its metadata); at least the measured peak. Admission counts it."
        },
        "staging_gib": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "replacement_gib": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "rollback_retained_generations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "boot_mem_overhead_mib": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "volume_floor_gib",
        "roots"
      ],
      "properties": {
        "schema": {
          "const": 2
        },
        "kind": {
          "const": "storage"
        },
        "volume_floor_gib": {
          "type": "integer",
          "minimum": 10,
          "maximum": 4096,
          "description": "Free space every volume holding a tier keeps; admission never plans below it."
        },
        "roots": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_root",
            "clone_root",
            "scratch_root",
            "staging_root"
          ],
          "properties": {
            "base_root": {
              "$ref": "#/$defs/root"
            },
            "clone_root": {
              "$ref": "#/$defs/root"
            },
            "scratch_root": {
              "$ref": "#/$defs/root"
            },
            "staging_root": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/root"
                }
              ],
              "description": "null means <base_root>\\staging."
            }
          }
        }
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "volume_guid"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/root_path"
        },
        "volume_guid": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "root_path": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[A-Za-z]:(\\\\[A-Za-z0-9_()-]([A-Za-z0-9 ._()-]*[A-Za-z0-9_()-])?)+$",
      "description": "Absolute folder on a drive-letter volume, at least one level below the volume root. No UNC or device path, no relative path, no `.` or `..` component, no trailing dot or space, no `~` short name, ASCII letters, digits, space, `.`, `_`, `(`, `)` and `-` only."
    }
  }
}
