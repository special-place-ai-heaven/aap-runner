{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/special-place-ai-heaven/aap-runner/blob/main/parity/contracts/allocator.schema.json",
  "title": "Host-wide runner slot allocator state (C:\\ProgramData\\aap-runner\\capacity\\allocator.json)",
  "x-contract-version": 1,
  "x-owner": "P09 (writer: supervisor capacity module); consumers P10, P11, P12, P16, P20, P22",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "written_at", "max_slots", "host", "host_reserve_percent", "share_mode", "profiles", "legacy_adopted", "reservations"],
  "properties": {
    "schema": {"const": 1},
    "revision": {"type": "integer", "minimum": 0, "description": "Strictly increasing on every write; a reader that sees a lower revision than it already applied ignores the file."},
    "written_at": {"$ref": "#/$defs/time"},
    "max_slots": {"const": 5},
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_cores", "mem_gib", "measured_at"],
      "properties": {
        "cpu_cores": {"type": "integer", "minimum": 1, "maximum": 1024},
        "mem_gib": {"type": "integer", "minimum": 1, "maximum": 4096},
        "measured_at": {"$ref": "#/$defs/time"}
      }
    },
    "host_reserve_percent": {"type": "integer", "minimum": 10, "maximum": 90},
    "share_mode": {"enum": ["even", "per_profile"]},
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linux", "windows"],
      "properties": {
        "linux": {"$ref": "#/$defs/profile"},
        "windows": {"$ref": "#/$defs/profile"}
      }
    },
    "legacy_adopted": {"type": "boolean"},
    "reservations": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/reservation"}}
  },
  "$defs": {
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "share_percent", "backend", "active_generation"],
      "properties": {
        "count": {"type": "integer", "minimum": 0, "maximum": 5},
        "share_percent": {"type": ["integer", "null"], "minimum": 0, "maximum": 90},
        "backend": {"enum": ["wsl-legacy", "hyperv-vm"]},
        "active_generation": {"type": ["string", "null"], "maxLength": 80}
      }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reservation_id", "slot", "profile", "backend", "image_generation", "lease_generation", "state", "idempotency_key", "acquired_at", "state_changed_at", "heartbeat_at", "cpus", "mem_gib", "disk_gib", "io_mbps", "vm_id", "runner_name", "cleanup_uncertain", "quarantine_reason", "teardown_proof"],
      "properties": {
        "reservation_id": {"type": "string", "pattern": "^r-[0-9a-f]{16}$"},
        "slot": {"type": "integer", "minimum": 1, "maximum": 5},
        "profile": {"enum": ["linux", "windows"]},
        "backend": {"enum": ["wsl-legacy", "hyperv-vm"]},
        "image_generation": {"type": "string", "pattern": "^(legacy-[a-z0-9.-]{1,40}|(win25-vs2026-x64|ubuntu-24.04-x64)/[0-9]{8}\\.[0-9]+\\.[0-9]+-aap\\.[0-9]+)$"},
        "lease_generation": {"type": "integer", "minimum": 1},
        "state": {"enum": ["creating", "ready", "busy", "draining", "collecting", "deleting", "quarantined", "reconciled"]},
        "idempotency_key": {"type": "string", "maxLength": 64},
        "acquired_at": {"$ref": "#/$defs/time"},
        "state_changed_at": {"$ref": "#/$defs/time"},
        "heartbeat_at": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "cpus": {"type": "integer", "minimum": 1, "maximum": 1024},
        "mem_gib": {"type": "integer", "minimum": 1, "maximum": 4096},
        "disk_gib": {"type": "integer", "minimum": 0, "maximum": 4096},
        "io_mbps": {"type": "integer", "minimum": 0, "maximum": 100000},
        "vm_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "runner_name": {"type": ["string", "null"], "pattern": "^aap-(crrr|fresh|w|l)-[a-z0-9-]{1,60}$"},
        "cleanup_uncertain": {"type": "boolean"},
        "quarantine_reason": {"type": ["string", "null"], "maxLength": 200},
        "teardown_proof": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["observed_at", "vm_absent", "disks_absent", "runner_deregistered"],
              "properties": {
                "observed_at": {"$ref": "#/$defs/time"},
                "vm_absent": {"const": true},
                "disks_absent": {"const": true},
                "runner_deregistered": {"enum": [true, "github-removed"]}
              }
            }
          ]
        }
      }
    }
  }
}
