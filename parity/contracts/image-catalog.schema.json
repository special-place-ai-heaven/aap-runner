{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/special-place-ai-heaven/aap-runner/blob/main/parity/contracts/image-catalog.schema.json",
  "title": "Immutable image generation catalog (<base_root>\\catalog.json, Administrators/SYSTEM only)",
  "x-contract-version": 2,
  "x-owner": "P21 (assembly, catalog writer), P25 (promotion/rollback operations); consumers P06, P07, P10, P11, P12, P19, P20, P24",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "scope",
    "profiles",
    "generations"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "scope": {
      "enum": [
        "lab",
        "live"
      ],
      "description": "lab: a disposable lab catalog; live: the owner's installation. live_activation (gate D5) is required for an active generation only in live."
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "win25-vs2026-x64",
        "ubuntu-24.04-x64"
      ],
      "properties": {
        "win25-vs2026-x64": {
          "$ref": "#/$defs/pointers"
        },
        "ubuntu-24.04-x64": {
          "$ref": "#/$defs/pointers"
        }
      }
    },
    "generations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/generation"
      }
    }
  },
  "$defs": {
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gen_id": {
      "type": "string",
      "pattern": "^(win25-vs2026-x64|ubuntu-24.04-x64)/[0-9]{8}\\.[0-9]+\\.[0-9]+-aap\\.[0-9]+$"
    },
    "pointers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "rollback"
      ],
      "properties": {
        "active": {
          "anyOf": [
            {
              "$ref": "#/$defs/gen_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "rollback": {
          "anyOf": [
            {
              "$ref": "#/$defs/gen_id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_id",
        "profile",
        "state",
        "state_changed_at",
        "baseline",
        "artifacts",
        "overlays",
        "provenance",
        "secret_scan",
        "certification",
        "approved_by",
        "retention",
        "quarantine_reason",
        "live_activation"
      ],
      "properties": {
        "generation_id": {
          "$ref": "#/$defs/gen_id"
        },
        "profile": {
          "enum": [
            "win25-vs2026-x64",
            "ubuntu-24.04-x64"
          ]
        },
        "state": {
          "enum": [
            "candidate",
            "approved",
            "active",
            "retired",
            "quarantined"
          ]
        },
        "state_changed_at": {
          "$ref": "#/$defs/time"
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runner_images_commit",
            "image_version",
            "inventory_path",
            "inventory_sha256"
          ],
          "properties": {
            "runner_images_commit": {
              "$ref": "#/$defs/sha1"
            },
            "image_version": {
              "type": "string",
              "pattern": "^[0-9]{8}\\.[0-9]+\\.[0-9]+$"
            },
            "inventory_path": {
              "enum": [
                "parity/baselines/windows-2025-vs2026-x64/inventory.json",
                "parity/baselines/ubuntu-24.04-x64/inventory.json"
              ]
            },
            "inventory_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "role": {
                "enum": [
                  "base_vhdx",
                  "overlay_bundle",
                  "seed_template"
                ]
              },
              "path": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
                "not": {
                  "pattern": "(^|/)\\.\\.?(/|$)"
                },
                "description": "Relative to base_root; validate.py requires the generation's own folder <generation_id>/."
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "overlays": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "sha256"
            ],
            "properties": {
              "name": {
                "enum": [
                  "guest-agent",
                  "actions-runner",
                  "zccache",
                  "cache-config"
                ]
              },
              "version": {
                "type": "string",
                "maxLength": 40,
                "pattern": "^[0-9A-Za-z.+-]+$"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "built_by_item",
            "builder_commit",
            "inputs_manifest_sha256",
            "built_at"
          ],
          "properties": {
            "built_by_item": {
              "enum": [
                "P06",
                "P07",
                "P21"
              ]
            },
            "builder_commit": {
              "$ref": "#/$defs/sha1"
            },
            "inputs_manifest_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "built_at": {
              "$ref": "#/$defs/time"
            }
          }
        },
        "secret_scan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "evidence_ref"
          ],
          "properties": {
            "result": {
              "enum": [
                "clean",
                "found",
                "not_run"
              ]
            },
            "evidence_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200,
                  "pattern": "^evidence/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
                  "not": {
                    "pattern": "(^|/)\\.\\.?(/|$)"
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "if": {
            "properties": {
              "result": {
                "const": "not_run"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ref": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "evidence_ref": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^evidence/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
                "not": {
                  "pattern": "(^|/)\\.\\.?(/|$)"
                }
              }
            }
          }
        },
        "certification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "certificate_ref",
            "certified_at"
          ],
          "properties": {
            "certificate_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200,
                  "pattern": "^parity/certificates/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
                  "not": {
                    "pattern": "(^|/)\\.\\.?(/|$)"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "certified_at": {
              "anyOf": [
                {
                  "$ref": "#/$defs/time"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "purpose",
            "expires_at"
          ],
          "properties": {
            "owner": {
              "enum": [
                "P21",
                "P25",
                "owner"
              ]
            },
            "purpose": {
              "enum": [
                "candidate",
                "active",
                "rollback",
                "evidence-only",
                "quarantine-hold"
              ]
            },
            "expires_at": {
              "anyOf": [
                {
                  "$ref": "#/$defs/time"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "quarantine_reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "live_activation": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "approved_by",
                "approved_at",
                "record_ref"
              ],
              "properties": {
                "approved_by": {
                  "const": "owner"
                },
                "approved_at": {
                  "$ref": "#/$defs/time"
                },
                "record_ref": {
                  "type": "string",
                  "maxLength": 200,
                  "pattern": "^evidence/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
                  "not": {
                    "pattern": "(^|/)\\.\\.?(/|$)"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
