{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/special-place-ai-heaven/aap-runner/blob/main/parity/contracts/host-network-module.schema.json",
  "title": "Host network module (P10.0): Attach's declaration, Verify's problem list, the module's journal record and a consumer's Hyper-V read-back",
  "x-contract-version": 1,
  "x-owner": "P10.0 (module); consumers P06, P07, P10, P11; P12 builds it; P19 the journal folder, switches and host rules",
  "oneOf": [
    {
      "$ref": "#/$defs/attach"
    },
    {
      "$ref": "#/$defs/problems"
    },
    {
      "$ref": "#/$defs/record"
    },
    {
      "$ref": "#/$defs/readback"
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "vm_name": {
      "type": "string",
      "pattern": "^aap-([wl]-[1-5]-[0-9]{1,9}-[0-9a-f]{8}|[wl]build-[0-9a-f]{8})$"
    },
    "ipv4": {
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
    },
    "subnet": {
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(1[6-9]|2[0-9]|30)$"
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "address"
      ],
      "properties": {
        "role": {
          "enum": [
            "gateway",
            "dhcp",
            "dns"
          ]
        },
        "address": {
          "$ref": "#/$defs/ipv4"
        }
      }
    },
    "attach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "vm_id",
        "vm_name",
        "profile",
        "subnet",
        "endpoints"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "kind": {
          "const": "host_network_attach"
        },
        "vm_id": {
          "$ref": "#/$defs/uuid"
        },
        "vm_name": {
          "$ref": "#/$defs/vm_name"
        },
        "profile": {
          "enum": [
            "windows",
            "linux"
          ]
        },
        "subnet": {
          "$ref": "#/$defs/subnet"
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        }
      }
    },
    "problems": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[ -~]{1,200}$"
      }
    },
    "created": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "adapter",
            "switch",
            "nat",
            "firewall_rule"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,79}$"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "state",
        "declaration",
        "created"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "kind": {
          "const": "host_network_record"
        },
        "state": {
          "enum": [
            "attaching",
            "attached"
          ]
        },
        "declaration": {
          "$ref": "#/$defs/attach"
        },
        "created": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/created"
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Action",
        "Direction",
        "RemoteAddress",
        "Scoped",
        "Weight"
      ],
      "properties": {
        "Action": {
          "type": "string",
          "maxLength": 16
        },
        "Direction": {
          "type": "string",
          "maxLength": 16
        },
        "RemoteAddress": {
          "type": "string",
          "maxLength": 64
        },
        "Scoped": {
          "type": "boolean"
        },
        "Weight": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SwitchName",
        "SwitchType",
        "DhcpGuard",
        "RouterGuard",
        "MacAddressSpoofing",
        "Acls"
      ],
      "properties": {
        "SwitchName": {
          "type": "string",
          "maxLength": 100
        },
        "SwitchType": {
          "type": "string",
          "maxLength": 16
        },
        "DhcpGuard": {
          "type": "boolean"
        },
        "RouterGuard": {
          "type": "boolean"
        },
        "MacAddressSpoofing": {
          "type": "boolean"
        },
        "Acls": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "declaration",
        "adapters"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "kind": {
          "const": "host_network_readback"
        },
        "declaration": {
          "$ref": "#/$defs/attach"
        },
        "adapters": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/adapter"
          }
        }
      }
    }
  }
}
