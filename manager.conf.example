# Installed to /etc/aap-runner/manager.conf, mode 0400, owner root.
# The GitHub App private key is a separate file. Neither file is committed
# with a secret in it. Empty values below are rejected by the manager.

AAP_GITHUB_ORG=special-place-ai-heaven
AAP_GITHUB_APP_ID=
AAP_GITHUB_APP_INSTALLATION_ID=
AAP_GITHUB_APP_PRIVATE_KEY_PATH=/etc/aap-runner/app.pem
AAP_RUNNER_IMAGE=aap-crrr-runner:local
AAP_RUNNER_LABELS=self-hosted,linux,crrr
AAP_RUNNER_GROUP=aap-crrr
# Free GiB required on /var/lib/ghrunner before a job starts. The disk is 60 GiB fixed.
AAP_DISK_FLOOR_GB=35
# docker create limits for one job. Absent keys use these same defaults.
AAP_JOB_MEMORY=12g
AAP_JOB_CPUS=6
AAP_JOB_PIDS_LIMIT=4096
# Stop and remove the container after this many minutes. 1..1440. Jobs time out at 90.
AAP_JOB_TIMEOUT_MINUTES=120
