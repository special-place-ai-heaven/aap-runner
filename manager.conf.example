# Installed to /etc/aap-runner/manager.conf, mode 0400, owner root.
# The GitHub App private key is a separate file. Neither file is committed
# with a secret in it. Empty values below are rejected by the manager.

AAP_GITHUB_ORG=special-place-ai-heaven
AAP_GITHUB_APP_ID=
AAP_GITHUB_APP_INSTALLATION_ID=
AAP_GITHUB_APP_PRIVATE_KEY_PATH=/etc/aap-runner/app.pem
AAP_RUNNER_IMAGE=aap-crrr-runner:local
# Third label. Default crrr, which is what ci.yml selects. Fresh sets fresh
# and does not carry crrr, so it runs a job only when the workflow names fresh.
AAP_RUNNER_BASE_LABEL=crrr
# Must be self-hosted,linux plus the base above. CRRR stays on crrr.
AAP_RUNNER_LABELS=self-hosted,linux,crrr
# Labels after the base. CRRR leaves this empty. Fresh sets heavy.
# Do not repeat self-hosted, linux, or the base label.
AAP_RUNNER_EXTRA_LABELS=
AAP_RUNNER_GROUP=aap-crrr
# Fixed VHDX size in GiB. CRRR is 60. Fresh sets 100; see the Fresh profile in README.md.
# df size must fall in this value minus 10 through plus 4. The example stays at 60.
AAP_WORK_DISK_GIB=60
# Free GiB required on /var/lib/ghrunner before a job starts.
# A value below 55% of AAP_WORK_DISK_GIB is raised. 60 GiB stays at 35.
AAP_DISK_FLOOR_GB=35
# Per-host docker create limits. CRRR65734 uses 12g and 6 cpus. Another host sets its own.
# Absent keys use those same CRRR defaults.
# docker create also sets --memory-swap to this same value and --cpu-shares 512.
AAP_JOB_MEMORY=12g
AAP_JOB_CPUS=6
AAP_JOB_PIDS_LIMIT=4096
# Stop and remove the container after this many minutes. 1..1440. Jobs time out at 90.
AAP_JOB_TIMEOUT_MINUTES=120
